subroutine checkpoint_io_noncollinear(u,reading,value,ios,limit)
 integer,intent(in)::u
 logical,intent(in)::reading
 type(s_noncollinear_state),intent(inout)::value
 integer,intent(inout)::ios
 integer(8),intent(in)::limit
 integer::lo(7),hi(7),k,j1,j2,j3,j4,j5,j6,j7,istat
 integer(8)::n,e
 logical::present_array
 if(ios/=0)return
 present_array=allocated(value%den_mat)
 if(reading)then
  read(u,iostat=ios)present_array
 else
  write(u,iostat=ios)present_array
 endif
 if(ios/=0)return
 if(reading)then
  if(allocated(value%den_mat))deallocate(value%den_mat)
 endif
 if(present_array)then
  if(.not.reading)then
   lo(1:5)=lbound(value%den_mat);hi(1:5)=ubound(value%den_mat)
  endif
 if(reading)then
  read(u,iostat=ios)lo(1:5),hi(1:5)
 else
  write(u,iostat=ios)lo(1:5),hi(1:5)
 endif
 if(ios/=0)return
  if(reading)then
   n=1_8
   do k=1,5
    e=int(hi(k),8)-int(lo(k),8)+1_8
    if(e<0_8.or.e>limit)then
     ios=1;return
    endif
    if(e>0_8)then
     if(n>limit/e)then
      ios=1;return
     endif
    endif
    n=n*e
   enddo
   allocate(value%den_mat(lo(1):hi(1),lo(2):hi(2),lo(3):hi(3),lo(4):hi(4),lo(5):hi(5)),stat=istat)
   if(istat/=0)then
    ios=1;return
   endif
  endif
 if(reading)then
  read(u,iostat=ios)value%den_mat
 else
  write(u,iostat=ios)value%den_mat
 endif
 if(ios/=0)return
 endif
 present_array=allocated(value%vxc_mat)
 if(reading)then
  read(u,iostat=ios)present_array
 else
  write(u,iostat=ios)present_array
 endif
 if(ios/=0)return
 if(reading)then
  if(allocated(value%vxc_mat))deallocate(value%vxc_mat)
 endif
 if(present_array)then
  if(.not.reading)then
   lo(1:5)=lbound(value%vxc_mat);hi(1:5)=ubound(value%vxc_mat)
  endif
 if(reading)then
  read(u,iostat=ios)lo(1:5),hi(1:5)
 else
  write(u,iostat=ios)lo(1:5),hi(1:5)
 endif
 if(ios/=0)return
  if(reading)then
   n=1_8
   do k=1,5
    e=int(hi(k),8)-int(lo(k),8)+1_8
    if(e<0_8.or.e>limit)then
     ios=1;return
    endif
    if(e>0_8)then
     if(n>limit/e)then
      ios=1;return
     endif
    endif
    n=n*e
   enddo
   allocate(value%vxc_mat(lo(1):hi(1),lo(2):hi(2),lo(3):hi(3),lo(4):hi(4),lo(5):hi(5)),stat=istat)
   if(istat/=0)then
    ios=1;return
   endif
  endif
 if(reading)then
  read(u,iostat=ios)value%vxc_mat
 else
  write(u,iostat=ios)value%vxc_mat
 endif
 if(ios/=0)return
 endif
 present_array=allocated(value%old_mat)
 if(reading)then
  read(u,iostat=ios)present_array
 else
  write(u,iostat=ios)present_array
 endif
 if(ios/=0)return
 if(reading)then
  if(allocated(value%old_mat))deallocate(value%old_mat)
 endif
 if(present_array)then
  if(.not.reading)then
   lo(1:3)=lbound(value%old_mat);hi(1:3)=ubound(value%old_mat)
  endif
 if(reading)then
  read(u,iostat=ios)lo(1:3),hi(1:3)
 else
  write(u,iostat=ios)lo(1:3),hi(1:3)
 endif
 if(ios/=0)return
  if(reading)then
   n=1_8
   do k=1,3
    e=int(hi(k),8)-int(lo(k),8)+1_8
    if(e<0_8.or.e>limit)then
     ios=1;return
    endif
    if(e>0_8)then
     if(n>limit/e)then
      ios=1;return
     endif
    endif
    n=n*e
   enddo
   allocate(value%old_mat(lo(1):hi(1),lo(2):hi(2),lo(3):hi(3)),stat=istat)
   if(istat/=0)then
    ios=1;return
   endif
  endif
 if(reading)then
  read(u,iostat=ios)value%old_mat
 else
  write(u,iostat=ios)value%old_mat
 endif
 if(ios/=0)return
 endif
 present_array=allocated(value%dmat_old)
 if(reading)then
  read(u,iostat=ios)present_array
 else
  write(u,iostat=ios)present_array
 endif
 if(ios/=0)return
 if(reading)then
  if(allocated(value%dmat_old))deallocate(value%dmat_old)
 endif
 if(present_array)then
  if(.not.reading)then
   lo(1:5)=lbound(value%dmat_old);hi(1:5)=ubound(value%dmat_old)
  endif
 if(reading)then
  read(u,iostat=ios)lo(1:5),hi(1:5)
 else
  write(u,iostat=ios)lo(1:5),hi(1:5)
 endif
 if(ios/=0)return
  if(reading)then
   n=1_8
   do k=1,5
    e=int(hi(k),8)-int(lo(k),8)+1_8
    if(e<0_8.or.e>limit)then
     ios=1;return
    endif
    if(e>0_8)then
     if(n>limit/e)then
      ios=1;return
     endif
    endif
    n=n*e
   enddo
   allocate(value%dmat_old(lo(1):hi(1),lo(2):hi(2),lo(3):hi(3),lo(4):hi(4),lo(5):hi(5)),stat=istat)
   if(istat/=0)then
    ios=1;return
   endif
  endif
 if(reading)then
  read(u,iostat=ios)value%dmat_old
 else
  write(u,iostat=ios)value%dmat_old
 endif
 if(ios/=0)return
 endif
 present_array=allocated(value%rot_ang)
 if(reading)then
  read(u,iostat=ios)present_array
 else
  write(u,iostat=ios)present_array
 endif
 if(ios/=0)return
 if(reading)then
  if(allocated(value%rot_ang))deallocate(value%rot_ang)
 endif
 if(present_array)then
  if(.not.reading)then
   lo(1:4)=lbound(value%rot_ang);hi(1:4)=ubound(value%rot_ang)
  endif
 if(reading)then
  read(u,iostat=ios)lo(1:4),hi(1:4)
 else
  write(u,iostat=ios)lo(1:4),hi(1:4)
 endif
 if(ios/=0)return
  if(reading)then
   n=1_8
   do k=1,4
    e=int(hi(k),8)-int(lo(k),8)+1_8
    if(e<0_8.or.e>limit)then
     ios=1;return
    endif
    if(e>0_8)then
     if(n>limit/e)then
      ios=1;return
     endif
    endif
    n=n*e
   enddo
   allocate(value%rot_ang(lo(1):hi(1),lo(2):hi(2),lo(3):hi(3),lo(4):hi(4)),stat=istat)
   if(istat/=0)then
    ios=1;return
   endif
  endif
 if(reading)then
  read(u,iostat=ios)value%rot_ang
 else
  write(u,iostat=ios)value%rot_ang
 endif
 if(ios/=0)return
 endif
end subroutine
