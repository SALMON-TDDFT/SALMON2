 ! | for TDDFT real-time calculations |
 ! +----------------------------------+
 
+  ! Immutable-after-initialization integration settings owned by each RT state.
+  type s_rt_step_config
+    real(8) :: dt=0d0
+    integer :: taylor_order=0
+    character(32) :: propagator=''
+    character(2) :: field_mode=''
+    real(8) :: film_thickness=0d0,epsilon_em(2)=1d0
+  end type s_rt_step_config
+
   type s_rt
+    type(s_rt_step_config) :: step
     real(8) :: Dp0_e(3)     !rename later
     real(8), allocatable :: dDp_e(:,:), Dp_e(:,:), Dp_i(:,:), Qp_e(:,:,:)    !rename later
     real(8), allocatable :: rIe(:)    !rename later
@@ -833,4 +843,40 @@
     DEAL(x%v)
   end subroutine deallocate_vector
 
+
+  subroutine configure_rt_step(config,delta_t,order,method,field_mode,thickness,epsilon,status)
+    use, intrinsic :: ieee_arithmetic, only: ieee_is_finite
+    type(s_rt_step_config),intent(inout) :: config
+    real(8),intent(in) :: delta_t,thickness,epsilon(2)
+    integer,intent(in) :: order
+    character(*),intent(in) :: method,field_mode
+    integer,intent(out) :: status
+    type(s_rt_step_config) :: candidate
+    integer :: i
+    status=1
+    if(.not.ieee_is_finite(delta_t))return
+    if(delta_t<=0d0.or.order<1)return
+    select case(method)
+    case('middlepoint','aetrs')
+    case('hse_taylor4')
+      if(order/=4)return
+    case default
+      return
+    end select
+    select case(field_mode)
+    case('tr','lo','2d')
+    case default
+      return
+    end select
+    if(.not.ieee_is_finite(thickness))return
+    if(thickness<0d0)return
+    do i=1,2
+      if(.not.ieee_is_finite(epsilon(i)))return
+      if(epsilon(i)<=0d0)return
+    end do
+    candidate%dt=delta_t;candidate%taylor_order=order;candidate%propagator=method
+    candidate%field_mode=field_mode;candidate%film_thickness=thickness;candidate%epsilon_em=epsilon
+    config=candidate;status=0
+  end subroutine configure_rt_step
+
 end module structures
