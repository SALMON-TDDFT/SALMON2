 contains
+  ! One solver group per process; point states must be owned separately.
+  ! Attachment never initializes MPI and owns only its duplicated communicator.
+  subroutine comm_attach(parent, ierr)
+    use mpi, only: MPI_SUCCESS, MPI_ERR_OTHER, MPI_INTEGER, MPI_MAX
+    integer, intent(in) :: parent
+    integer, intent(out) :: ierr
+    logical :: initialized, finalized, inter
+    integer :: local_error, group_error
+    call MPI_Initialized(initialized,ierr)
+    call MPI_Finalized(finalized,ierr)
+    if(.not.initialized.or.finalized.or.parent==MPI_COMM_NULL) then
+      ierr=MPI_ERR_OTHER
+      return
+    end if
+    call MPI_Comm_test_inter(parent,inter,ierr)
+    if(inter) then
+      ierr=MPI_ERR_OTHER
+      return
+    end if
+    local_error=0
+    if(embedded_comm/=MPI_COMM_NULL) local_error=1
+    call MPI_Allreduce(local_error,group_error,1,MPI_INTEGER,MPI_MAX,parent,ierr)
+    if(group_error/=0) then
+      ierr=MPI_ERR_OTHER
+      return
+    end if
+    call MPI_Comm_dup(parent,embedded_comm,ierr)
+    if(ierr==MPI_SUCCESS) allocate(embedded_children(0))
+  end subroutine
+
+  subroutine comm_detach(ierr)
+    use mpi, only: MPI_SUCCESS, MPI_ERR_OTHER
+    integer, intent(out) :: ierr
+    integer :: i
+    if(embedded_comm==MPI_COMM_NULL) then
+      ierr=MPI_ERR_OTHER
+      return
+    end if
+    ! Descendants are created and closed in collective native order. Free them
+    ! before the attached parent, after all state request caches are finalized.
+    do i=size(embedded_children),1,-1
+      if(embedded_children(i)/=MPI_COMM_NULL) call MPI_Comm_free(embedded_children(i),ierr)
+    end do
+    deallocate(embedded_children)
+    call MPI_Comm_free(embedded_comm,ierr)
+  end subroutine
+
+  subroutine track_embedded_group(group)
+    integer,intent(in) :: group
+    if(embedded_comm/=MPI_COMM_NULL.and.group/=MPI_COMM_NULL) then
+      embedded_children=[embedded_children,group]
+    end if
+  end subroutine
+
