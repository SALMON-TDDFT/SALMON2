+! Native E_n clock, A/J at (n+1/2)dt; sample map matches eh_sendrecv('s').
+#include "config.h"
+module salmonpy_eh_context
+  use iso_c_binding
+  use structures, only: s_fdtd_system
+  use fdtd_eh, only: ls_fdtd_eh,eh_init,eh_calc,eh_finalize
