! H2 2frag pure-DG topology probe: keep geometry fixed, use subgroup size 1

&calculation
  theory = 'single_scale_maxwell_tddft'
/

&control
  sysname = 'H2_contract_nt1_t0_rgrid111_probe'
/

&units
  unit_system = 'a.u.'
/

&dc
  num_fragment(1:3) = 2,1,1
  nproc_rgrid_tot = 2,1,1
  nstate_frag = 25
  num_rgrid_buffer = 5,0,0
  yn_dg_fragment_from_dcdft = 'y'
/

&parallel
  nproc_k = 1
  nproc_ob = 1
  nproc_rgrid(1:3) = 1,1,1
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 120, 40, 40
/

&tgrid
  nt = 1
  dt = 0.05d0
/

&propagation
  propagator = 'middlepoint'
  yn_dg_fragment_rt = 'y'
  time_integrator_dg_fragment = 'rk4'
/

&scf
  ncg = 5
/

&emfield
  trans_longi = 'tr'
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 0.0d0
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&analysis
  yn_out_psi = 'n'
  yn_out_dns = 'n'
  yn_out_dos = 'n'
  yn_out_pdos = 'n'
  yn_out_elf = 'n'
  yn_out_rvf_rt = 'n'
/

&dg_fragment
  yn_dg_frag = 'y'
  eps_dg_frag = 1d-10
  yn_adaptive_basis_dg = 'y'
  yn_dg_fragment_rt = 'y'
  niter_dg_frag_rt_max = 5
/

&multiscale
  fdtddim = '1d'
  twod_shape = 'periodic'
  nx_m = 1
  ny_m = 1
  nz_m = 1
  hx_m = 400.0d0
  hy_m = 400.0d0
  hz_m = 400.0d0
/

&singlescale
  method_singlescale = '1d'
/

&restart
  restart_option = 'restart'
  yn_restart_dcdft_gs = 'y'
/

