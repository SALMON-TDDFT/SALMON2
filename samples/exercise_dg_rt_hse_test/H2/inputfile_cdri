!========================================================================================
! H2 Molecule - Real-Time TDDFT with HSE + CD-RI (Fast + Memory Efficient)
!
! Purpose: Fast HSE with Cholesky Decomposition RI (memory-optimized)
! Speedup: ~120x vs Plan A; Memory: ~50% reduction vs Plan C
! Prerequisite: LDA GS calculation
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_cdri_rt'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'hse'
/

&functional_hse
  omega_inv_hse = 9.0909d0
  alpha_hse = 0.25d0
  yn_hse_ri = 'y'
  yn_hse_cd_ri = 'y'
  hse_cd_ri_threshold = 1.0d-8
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&tgrid
  nt = 10
  dt = 0.1d0
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/

  yn_fix_func = 'n'
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1 = 1.0, 0.0, 0.0
  I_wcm2_1 = 1.0d12
/

&atomic_coor
  'H'  0.0  0.0  -0.7  1
  'H'  0.0  0.0   0.7  1
/

!*********************************************************************************!
! COMMENTS FOR CD-RI (Cholesky Decomposition RI):
!
! yn_hse_cd_ri = 'y'
!   → Cholesky分解を用いた RI/DF 近似
!   → Coulomb行列 V_PQ を分解: V_PQ ≈ L_P * L_Q^T
!   → メモリー使用量: N_aux^2 → N_aux × N_chol
!   → N_chol は通常 N_aux より大幅に小さい
!
! hse_cd_ri_threshold = 1.0d-8
!   → Cholesky分解の数値精度しきい値
!   → 推奨値: 1.0d-8 (default, good balance)
!   → 選択肢:
!       1.0d-6: 高速（精度 0.1%）
!       1.0d-8: 推奨（精度 0.01%）← これ
!       1.0d-10: 高精度（精度 0.001%）
!
! メモリー効果:
!   H2: N_aux=6, N_chol~4 → 50% reduction (6→4)
!   Large systems: N_aux=9600, N_chol~3000 → 70% reduction
!   Si64: V_PQ from 738 MB → 148 MB (80% reduction)
!
! 期待精度: Plan C との差 < 0.0001 a.u.
!
! For quick test:
! - nt = 10 (only 10 steps for test)
! - hse_cd_ri_threshold = 1.0d-6 (faster for test)
!
!*********************************************************************************!
