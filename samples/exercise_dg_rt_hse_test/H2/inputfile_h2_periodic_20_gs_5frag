!========================================================================================
! H2 Periodic Superlattice (20 molecules) - Ground State with DC-LCFO (5 Fragments)
!
! Purpose: Test DC-LCFO fragmentation with 5 fragments along x-direction
!          Strong scaling test: compare 1 fragment vs 5 fragments
!
! System: 20 H2 molecules spaced along x-direction (2.8 a.u. spacing)
!         Fragmentation: num_fragment(1:3) = 5, 1, 1
!         - Each fragment: ~4 H2 molecules (8 electrons, ~16-20 states)
!         - Total: 40 electrons, 80 states
!
!========================================================================================

&calculation
  theory = 'dft'
  yn_dc = 'y'
/

&control
  sysname = 'H2_periodic_20_dc_5frag'
/

&units
  unit_system = 'a.u.'
/

&dc
  num_fragment(1:3) = 5,1,1    ! 5 fragments along x-direction
  nproc_rgrid_tot = 5,1,1      ! Total MPI processes = 5 (must match product of fragments)
  yn_dc_lcfo = 'y'
  yn_dc_lcfo_diag = 'y'
  nstate_frag = 35              ! Increase: 4 H2 × ~8-9 states/H2 + buffer
  num_rgrid_buffer = 10,0,0    ! Buffer only in x-direction (fragment boundary direction)
/

&parallel
  nproc_k = 1
  nproc_ob = 1
  nproc_rgrid(1:3) = 1,1,1
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 120, 40, 40
/

&scf
  nscf = 300
  threshold = 1.0d-9
  convergence = 'gradient_norm'
/

&atomic_coor
  'H'  0.0d0   0.0d0  -0.35d0  1
  'H'  0.0d0   0.0d0   0.35d0  1
