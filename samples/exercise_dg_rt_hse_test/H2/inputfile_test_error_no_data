! Test: yn_dg_fragment_from_dcdft='n' without restart should error
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_periodic_test_error2'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&dc
  num_fragment(1:3) = 1,1,1
  nstate_frag = 40
  yn_dg_fragment_from_dcdft = 'n'  ! No data loading
/

&rgrid
  num_rgrid = 120, 40, 40
/

&tgrid
  nt = 1
  dt = 0.05d0
/

&restart
  yn_restart = 'n'  ! No restart either -> should error
/

&propagation
  yn_dg_fragment_rt = 'y'  ! Enable DG-Fragment RT
/

