!========================================================================================
! H2 Periodic Superlattice (20 molecules) - Ground State with DC-LCFO
!
! Purpose: Create artificial periodic system by arranging 20 H2 molecules
!          Apply DC-LCFO fragmentation for adaptive basis refinement
!          This enables testing of DG-Fragment RT on extended periodic systems
!
! System: 20 H2 molecules spaced along z-direction in periodic box
!         Expected properties:
!         - 40 electrons total (2 electrons × 20 H2)
!         - ~80 states (4 states per H2 or more for periodic system)
!         - Fragmentation: each H2 can be treated as separate fragment
!
!========================================================================================

&calculation
  theory = 'dft'
  yn_dc = 'y'
/

&control
  sysname = 'H2_periodic_20_dc_2frag'
/

&units
  unit_system = 'a.u.'
/

&dc
  num_fragment(1:3) = 2,1,1    ! 2 fragments along x-direction
  nproc_rgrid_tot = 2,1,1      ! Total MPI processes = 2
  yn_dc_lcfo = 'y'
  yn_dc_lcfo_diag = 'y'
  nstate_frag = 25              ! ~10 H2 per fragment: 20 electrons → ~20-25 states
  num_rgrid_buffer = 5,0,0     ! Buffer only in x-direction (fragment boundary direction)
/

&parallel
  nproc_k = 1
  nproc_ob = 1
  nproc_rgrid(1:3) = 1,1,1
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 120, 40, 40
/

&scf
  nscf = 300
  threshold = 1.0d-9
/

&atomic_coor
