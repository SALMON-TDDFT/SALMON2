!========================================================================================
! H2 Molecule - Real-Time TDDFT with HSE (Plan A: Direct)
!
! Purpose: Time-dependent evolution with HSE functional (full accuracy, slower)
! Prerequisite: LDA GS calculation (use for basis, then apply HSE in RT)
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_hse_rt'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'hse'
/

&functional_hse
  omega_inv_hse = 9.0909d0
  alpha_hse = 0.25d0
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&tgrid
  nt = 10
  dt = 0.1d0
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/


!*********************************************************************************!
! EXECUTION FLOW:
!
! Step 1: GS calculation
!   $ SALMON < inputfile_lda_gs
!   → generates nutilus_frag*.dat
!
! Step 2: This RT calculation
!   $ SALMON < inputfile_plan_a_rt
!   → reads nutilus_frag*.dat
!   → evolves coefficients with HSE functional
!
! Note on HSE Plan A:
! - Most accurate HSE calculation
! - Uses direct exchange integration (expensive)
! - Expected time: slow (60-120x longer than LDA RT)
! - This is the reference/ground truth
!
!*********************************************************************************!
