!========================================================================================
! H2 Periodic Superlattice (20 molecules) - Real-Time with DG-Fragment (1 Fragment)
!
! Purpose: Time-dependent evolution using DC-LCFO GS data with DG-Fragment RT
!          Single fragment version for performance comparison baseline
!
! Prerequisites:
!   - DC-LCFO GS calculation completed: inputfile_h2_periodic_20_gs_1frag
!   - data_dcdft/ directory with single fragment data must exist
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_periodic_20_dc_1frag'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&dc
  num_fragment(1:3) = 1,1,1    ! Single fragment
  nproc_rgrid_tot = 1,1,1      ! Total MPI processes = 1
  nstate_frag = 40
  yn_adaptive_basis = 'n'
  yn_dg_fragment_from_dcdft = 'y'   ! Load DC-LCFO data for DG-Fragment RT
/

&parallel
  nproc_k = 1
  nproc_ob = 1                 ! 1 MPI process for orbital parallelization
  nproc_rgrid(1:3) = 1,1,1
/

&rgrid
  num_rgrid = 120, 40, 40
/

&tgrid
  nt = 20
  dt = 0.05d0
/

&scf
  ncg = 5
/

&emfield
  trans_longi = 'tr'
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&analysis
  yn_out_psi = 'n'
  yn_out_dns = 'n'
  yn_out_rvf_rt = 'y'
/

&propagation
  yn_dg_fragment_rt = 'y'
/

