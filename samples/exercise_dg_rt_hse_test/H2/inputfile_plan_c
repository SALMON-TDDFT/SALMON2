!========================================================================================
! H2 Molecule - Real-Time TDDFT with HSE + RI/DF (Plan C: Fast)
!
! Purpose: Fast HSE RT using Resolution of Identity (Density Fitting)
! Speedup: ~60x vs Plan A direct; Accuracy: <0.03% error
! Prerequisite: LDA GS calculation
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_ri_rt'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'hse'
/

&functional_hse
  omega_inv_hse = 9.0909d0
  alpha_hse = 0.25d0
  yn_hse_ri = 'y'
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&tgrid
  nt = 10
  dt = 0.1d0
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/


&propagation
  propagator = 'etrs'
  yn_fix_func = 'n'
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1 = 1.0, 0.0, 0.0
  I_wcm2_1 = 1.0d12
/

&atomic_coor
  'H'  0.0  0.0  -0.7  1
  'H'  0.0  0.0   0.7  1
/

!*********************************************************************************!
! COMMENTS FOR PLAN C (RI/DF):
!
! yn_hse_ri = 'y'
!   → 3-index electron repulsion integrals (ij|P) を使用
!   → 交換相互作用を補助基底で展開
!   → ~60倍高速化（Plan Aの場合）
!
! hse_ri_ratio = 3.0
!   → N_aux = 3 * N_basis
!   → H2: N_basis=2 なら N_aux=6
!   → 化学精度を確保（精度損失 <0.03%）
!   → 選択肢:
!       2.0: 高速（精度 0.3%）
!       3.0: 推奨（精度 0.03%）← これ
!       4.0: 高精度（精度 0.01%）
!
! 期待精度: Plan A との差 < 0.0003 a.u.
!
! For quick test:
! - nt = 10 (only 10 steps for test)
! - dl = 0.8 (coarser grid if needed)
! - hse_ri_ratio = 2.5 (faster but lower accuracy)
!
!*********************************************************************************!
