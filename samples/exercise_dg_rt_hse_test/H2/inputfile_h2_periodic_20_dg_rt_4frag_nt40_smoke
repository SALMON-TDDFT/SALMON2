!========================================================================================
! H2 Periodic Superlattice (20 molecules) - RT with DG-Fragment (4 Fragments)
!
! Purpose: Real-time TDDFT with DG-Fragment method using 4-fragment DC-LCFO
!          Compare with 2-fragment and test strong scaling
!
! System: 20 H2 molecules, 4 fragments along x-direction
!         Uses GS data from DC-LCFO calculation (data_dcdft/)
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_periodic_20_dc_4frag'
/

&units
  unit_system = 'a.u.'
/

&dc
  num_fragment(1:3) = 4,1,1    ! 4 fragments along x-direction
  nproc_rgrid_tot = 4,1,1      ! Total MPI processes = 4
  nstate_frag = 22
  num_rgrid_buffer = 8,0,0     ! Buffer only in x-direction
  yn_dg_fragment_from_dcdft = 'y'   ! Load DC-LCFO data for DG-Fragment RT
/

&parallel
  nproc_k = 1
  nproc_ob = 4                 ! 4 MPI processes for orbital parallelization
  nproc_rgrid(1:3) = 1,1,1
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 120, 40, 40
/

&tgrid
  nt = 40
  dt = 0.05d0
/

&scf
  ncg = 5
/

&emfield
  trans_longi = 'tr'
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&analysis
  yn_out_psi = 'n'
  yn_out_dns = 'n'
  yn_out_rvf_rt = 'y'
/

&propagation
  yn_dg_fragment_rt = 'y'
  time_integrator_dg_fragment = 'rk4'
  yn_dc_cg_basis_update = 'n'
/

&atomic_coor
