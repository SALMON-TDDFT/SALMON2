!========================================================================================
! H2 Molecule - Real-Time TDDFT with LDA
!
! Purpose: Time-dependent evolution under pulsed electric field
! Prerequisite: LDA GS calculation (generates restart/ directory data)
!
!========================================================================================

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'H2_lda_rt'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&tgrid
  nt = 10
  dt = 0.1d0
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/


!*********************************************************************************!
! WORKFLOW:
!
! 1. Run GS first:
!    SALMON < inputfile_lda_gs > stdout_lda_gs.log
!
! 2. Check GS output files exist:
!    ls -la nutilus_frag*.dat ene.out
!
! 3. Then run RT (in same directory):
!    SALMON < inputfile_lda_rt > stdout_lda_rt.log
!
! RT calculation automatically reads:
!   - nutilus_frag*.dat from current directory
!   - Uses them as initial basis for time evolution
!
! Expected output:
!   - Jxyz*.out (current density)
!   - dens*.txt (density)
!   - dipole.txt (dipole moment)
!
!*********************************************************************************!
