!========================================================================================
! H2 Molecule - DC-LCFO Ground State (Divide-and-Conquer with Fragment Orbitals)
!
! Purpose: Calculate ground state with DC method
!          DC-LCFO generates fragment orbitals for DG-Fragment RT time evolution
!
! Key requirements:
!   - yn_periodic='y' (DC only works with periodic systems)
!   - yn_dc='y' (master DC enable)
!   - num_fragment(1:3): Fragment division structure
!   - nstate_frag: Number of states per fragment
!
!=========================================================================================

&calculation
  theory = 'dft'
/

&control
  sysname = 'H2_dc'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&scf
  nscf = 100
  threshold = 1.0d-9
/

!========================================================================================
! DC-LCFO Parameters (Global scope, NOT in &parallel section)
!========================================================================================
! DC (Divide-and-Conquer) Settings
!   yn_dc: 'y' to enable DC method
!   num_fragment(1:3): Division of system in x,y,z directions
!   nstate_frag: Number of states to retain per fragment
!   yn_dc_lcfo: 'y' to use LCFO (Local Coupled Functional Operator)
!   yn_dc_lcfo_diag: 'y' to use diagonalization method in LCFO
!========================================================================================

!&dc
!  yn_dc = 'y'
!  num_fragment(1) = 2
!  num_fragment(2) = 1
!  num_fragment(3) = 1
!  nstate_frag = 3
!  yn_dc_lcfo = 'y'
!  yn_dc_lcfo_diag = 'y'
!/

!========================================================================================
! NOTE: DC is for periodic systems (bulk materials, crystals)
! H2 molecule is NOT periodic - DC method is not applicable
! 
! For now, use standard DFT GS + DG-Fragment RT workflow:
!   1. Standard DFT GS calculation
!   2. DG-Fragment RT uses standard GS basis
!   3. Simulates fragment-based dynamics
!=========================================================================================

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/

