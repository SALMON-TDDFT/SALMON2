!========================================================================================
! H2 Molecule - Simplified Ground State with HSE (Optional)
!
! Purpose: Ground state calculation with HSE functional (slower than LDA)
! For most purposes, use LDA GS basis instead for time-dependent calculations
!
!========================================================================================

&calculation
  theory = 'dft'
/

&control
  sysname = 'H2_hse'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 3
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'hse'
/

&functional_hse
  omega_inv_hse = 9.0909d0
  alpha_hse = 0.25d0
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
  num_rgrid = 40, 40, 40
/

&scf
  nscf = 100
  threshold = 1.0d-9
/

&atomic_coor
  'H'  0.0d0  0.0d0  -0.7d0  1
  'H'  0.0d0  0.0d0   0.7d0  1
/


!*********************************************************************************!
! NOTE: For testing, this is OPTIONAL
!
! Alternative approach:
!   Use LDA GS output (inputfile_lda_gs)
!   Then use HSE in RT calculation
!
! This works because:
!   - GS basis (fragment wavefunctions) from LDA is reasonable
!   - HSE functional is applied during RT evolution
!   - Saves significant computational time
!
! Typical workflow for HSE tests:
!   1. Run: SALMON < inputfile_lda_gs
!   2. Run: SALMON < inputfile_plan_a_rt
!      (uses LDA GS basis, evolves with HSE)
!
!*********************************************************************************!
