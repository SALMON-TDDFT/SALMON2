!========================================================================================
! H2 Periodic Superlattice (20 molecules) - Real-Time with DG-Fragment
!
! Purpose: Time-dependent evolution using DC-LCFO GS data with DG-Fragment RT
!          Uses NEW parameter: yn_dg_fragment_from_dcdft='y'
!
! Prerequisites:
!   - DC-LCFO GS calculation completed: inputfile_h2_periodic_20_gs
!   - data_dcdft/ directory with fragment data must exist
!
! NEW in v2.2.2:
!   yn_dg_fragment_from_dcdft='y' : Load DC-LCFO data for DG-Fragment RT
!   (Different from yn_conventional_from_dcdft which is for conventional RT)
!========================================================================================

&calculation
  theory = 'tddft_pulse'
  ! yn_conventional_from_dcdft = 'n'  ! NOT for DG-Fragment RT
/

&control
  sysname = 'H2_periodic_20_dg_new_param'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 56.0d0, 20.0d0, 20.0d0
  nstate = 80
  nelec = 40
  nelem = 1
  natom = 40
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&dc
  num_fragment(1:3) = 1,1,1
  nstate_frag = 40
  yn_dg_fragment_from_dcdft = 'y'   ! NEW: Load DC-LCFO data for DG-Fragment RT
/

&dg_fragment
  yn_adaptive_basis = 'n'           ! Start without adaptive basis for initial test
/

&rgrid
  num_rgrid = 120, 40, 40
/

&tgrid
  nt = 20
  dt = 0.05d0                       ! Required for stability
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0
  I_wcm2_1 = 1.0d12
  omega1 = 0.05d0
  tw1 = 6.0d0
/

&restart
  yn_restart = 'n'
/

&propagation
  yn_dg_fragment_rt = 'y'           ! Enable DG-Fragment RT
/

&atomic_coor
  'H'  0.0d0   0.0d0  -0.35d0  1
