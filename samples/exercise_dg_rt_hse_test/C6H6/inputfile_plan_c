!*********************************************************************************!
! C6H6 (Benzene) Test - Plan C (RI/DF)
!
! Purpose: Medium-scale system test with RI/DF approximation
! System: C6H6 benzene ring
!   - N_basis: ~42 (STO-3G or similar minimal basis)
!   - N_aux: ~126 (hse_ri_ratio = 3.0)
!   - N_atoms: 12  (6 Carbon + 6 Hydrogen)
!   - Symmetry: D6h
!
! Timing (expected):
! - Initialization: ~10 minutes (RI/DF overhead)
! - Per timestep: ~10 seconds
! - Memory: ~100-150 MB
! - Accuracy: <0.03% vs strict DFT
!
!*********************************************************************************!

&calculation
  calc_mode = 'RT'
  theory = 'dft'
  use_dg_fragment = 'y'
/

&control
  sysname = 'C6H6_plan_c'
  directory = './'
/

&units
  unit_system = 'a.u.'
/

&system
  iperiodic = 0
  al = 25d0, 25d0, 25d0
  nstate = 25
  nelec = 42
  nelem = 2
  natom = 12
/

&pseudo
  izatom(1) = 6
  izatom(2) = 1
  pseudo_file(1) = './C_rps.dat'
  pseudo_file(2) = './H_rps.dat'
  lloc_ps(1) = 1
  lloc_ps(2) = 0
/

&functional
  xc = 'pbe'
  yn_hse = 'y'
  hse_alpha = 0.25
  hse_omega = 0.11
  yn_hse_ri = 'y'            ! ✅ RI/DF enabled
  hse_ri_ratio = 3.0         ! Chemical accuracy
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
/

&tgrid
  nt = 100                    ! More reasonable for C6H6
  dt = 0.1
/

&dg_fragment
  num_fragment = 3, 2, 1
  nstate_frag = 20
  time_integrator_dg_fragment = 'AETRS'
/

&propagation
  propagator = 'etrs'
  yn_fix_func = 'n'
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1 = 1.0, 0.0, 0.0
  I_wcm2_1 = 1.0d12
/

&atomic_coor
  ! Benzene ring with C-C bond length ~ 2.6 a.u.
  'C'   2.6   0.0   0.0   1
  'C'   1.3   2.25  0.0   1
  'C'  -1.3   2.25  0.0   1
  'C'  -2.6   0.0   0.0   1
  'C'  -1.3  -2.25  0.0   1
  'C'   1.3  -2.25  0.0   1
  
  ! Hydrogen atoms at C-H bonds
  'H'   4.6   0.0   0.0   1
  'H'   2.3   3.9   0.0   1
  'H'  -2.3   3.9   0.0   1
  'H'  -4.6   0.0   0.0   1
  'H'  -2.3  -3.9   0.0   1
  'H'   2.3  -3.9   0.0   1
/

!*********************************************************************************!
! COMMENTS FOR C6H6 PLAN C:
!
! System Characteristics:
!   - Medium-scale organic molecule (12 atoms)
!   - 42 basis functions (minimal basis STO-3G)
!   - 126 auxiliary basis functions (N_aux/N_basis = 3.0)
!   - High-symmetry structure (D6h)
!
! Expected Performance:
!   - Initialization: ~10 min (includes RI/DF setup)
!   - Step: ~10 sec (vs ~600 sec for Plan A, 60x speedup)
!   - Memory: ~150 MB (vs ~1.5 GB for full ERI, 10x reduction)
!
! Fragment Division:
!   num_fragment = 3, 2, 1
!   → Divides 6 carbon atoms into 3 fragments along one direction
!   → Each fragment gets 2 carbons + 2 hydrogens
!   → Allows DC-LCFO basis construction
!
! For Quick Test:
!   - nt = 20 (faster test)
!   - dl = 0.7 (coarser grid)
!   - nstate_frag = 15 (fewer basis states)
!
!*********************************************************************************!
