!*********************************************************************************!
! C6H6 (Benzene) Test - LDA (No Hybrid Functional)
!
! Purpose: Baseline test with LDA on medium-scale system
! System: C6H6 benzene ring (12 atoms, ~42 basis functions)
! Method: DFT-LDA with DG-Fragment RT-TDDFT
!
! This validates DG-Fragment RT works correctly for molecules
! with multiple atom types and reasonable complexity.
!
! Expected performance:
! - LDA: Very fast (no integral overhead)
! - Initialization: ~1  minute
! - Per timestep: ~0.1-0.5 seconds
! - Total for 100 steps: ~15-20 seconds
!
!*********************************************************************************!

&calculation
  calc_mode = 'RT'
  theory = 'dft'
  use_dg_fragment = 'y'
/

&control
  sysname = 'C6H6_lda'
  directory = './'
/

&units
  unit_system = 'a.u.'
/

&system
  iperiodic = 0
  al = 25d0, 25d0, 25d0
  nstate = 25
  nelec = 42
  nelem = 2
  natom = 12
/

&pseudo
  izatom(1) = 6
  izatom(2) = 1
  pseudo_file(1) = './C_rps.dat'
  pseudo_file(2) = './H_rps.dat'
  lloc_ps(1) = 1
  lloc_ps(2) = 0
/

&functional
  xc = 'lda'              ! ✅ Simple LDA (no HSE, no GGA)
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
/

&tgrid
  nt = 100
  dt = 0.1
/

&dg_fragment
  num_fragment = 3, 2, 1
  nstate_frag = 20
  time_integrator_dg_fragment = 'AETRS'
/

&propagation
  propagator = 'etrs'
  yn_fix_func = 'n'
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1 = 1.0, 0.0, 0.0
  I_wcm2_1 = 1.0d12
/

&atomic_coor
  ! Benzene ring with C-C bond length ~ 2.6 a.u.
  'C'   2.6   0.0   0.0   1
  'C'   1.3   2.25  0.0   1
  'C'  -1.3   2.25  0.0   1
  'C'  -2.6   0.0   0.0   1
  'C'  -1.3  -2.25  0.0   1
  'C'   1.3  -2.25  0.0   1
  
  ! Hydrogen atoms at C-H bonds
  'H'   4.6   0.0   0.0   1
  'H'   2.3   3.9   0.0   1
  'H'  -2.3   3.9   0.0   1
  'H'  -4.6   0.0   0.0   1
  'H'  -2.3  -3.9   0.0   1
  'H'   2.3  -3.9   0.0   1
/

!*********************************************************************************!
! COMMENTS:
!
! LDA Baseline Test:
! - xc = 'lda' (simplest local functional)
! - No exchange integrals needed
! - No approximations (RI/DF, etc.)
! - Direct measurement of DG-Fragment overhead
!
! Purpose: 
! 1. Verify DG-Fragment implementation is correct
! 2. Establish baseline RT-TDDFT performance
! 3. Compare against HSE later
!
! Expected results:
! - Initialization: ~ 1 minute (DC-LCFO only)
! - 100 steps: ~ 20-30 seconds
! - Total: ~1-2 minutes
!
! If LDA works, then:
! - ✅ DG-Fragment initialization is OK
! - ✅ Time propagation is OK
! - ✅ Fragment orbital handling is OK
! - Then we can safely add HSE complexity
!
!*********************************************************************************!
