!*********************************************************************************!
! C6H6 (Benzene) Test - CD-RI (Cholesky Decomposition RI) [RECOMMENDED]
!
! Purpose: Memory-efficient medium-scale system test
! System: C6H6 benzene ring
!   - N_basis: ~42 (basis functions)
!   - N_aux: ~126 (before Cholesky)
!   - N_chol: ~50-60 (after Cholesky decomposition)
!   - N_atoms: 12  (6 Carbon + 6 Hydrogen)
!   - Symmetry: D6h
!
! Timing (expected):
! - Initialization: ~10 minutes (RI/DF setup same as Plan C)
! - Per timestep: ~8 seconds (slightly faster than Plan C)
! - Memory: ~50-75 MB (CD-RI reduces by 50-70%)
! - Accuracy: <0.01% (excellent agreement with Plan C)
!
! RECOMMENDATION: This is the PREFERRED method for C6H6!
!
!*********************************************************************************!

&calculation
  calc_mode = 'RT'
  theory = 'dft'
  use_dg_fragment = 'y'
/

&control
  sysname = 'C6H6_cdri'
  directory = './'
/

&units
  unit_system = 'a.u.'
/

&system
  iperiodic = 0
  al = 25d0, 25d0, 25d0
  nstate = 25
  nelec = 42
  nelem = 2
  natom = 12
/

&pseudo
  izatom(1) = 6
  izatom(2) = 1
  pseudo_file(1) = './C_rps.dat'
  pseudo_file(2) = './H_rps.dat'
  lloc_ps(1) = 1
  lloc_ps(2) = 0
/

&functional
  xc = 'pbe'
  yn_hse = 'y'
  hse_alpha = 0.25
  hse_omega = 0.11
  yn_hse_ri = 'y'            ! ✅ RI/DF enabled
  hse_ri_ratio = 3.0         ! N_aux/N_basis ratio
  yn_hse_cd_ri = 'y'         ! ✅ Cholesky decomposition enabled
  hse_cd_ri_threshold = 1.0d-8  ! Cholesky threshold
/

&rgrid
  dl = 0.5d0, 0.5d0, 0.5d0
/

&tgrid
  nt = 100                    ! More reasonable for C6H6
  dt = 0.1
/

&dg_fragment
  num_fragment = 3, 2, 1
  nstate_frag = 20
  time_integrator_dg_fragment = 'AETRS'
/

&propagation
  propagator = 'etrs'
  yn_fix_func = 'n'
/

&emfield
  ae_shape1 = 'impulse'
  epdir_re1 = 1.0, 0.0, 0.0
  I_wcm2_1 = 1.0d12
/

&atomic_coor
  ! Benzene ring with C-C bond length ~ 2.6 a.u.
  'C'   2.6   0.0   0.0   1
  'C'   1.3   2.25  0.0   1
  'C'  -1.3   2.25  0.0   1
  'C'  -2.6   0.0   0.0   1
  'C'  -1.3  -2.25  0.0   1
  'C'   1.3  -2.25  0.0   1
  
  ! Hydrogen atoms at C-H bonds
  'H'   4.6   0.0   0.0   1
  'H'   2.3   3.9   0.0   1
  'H'  -2.3   3.9   0.0   1
  'H'  -4.6   0.0   0.0   1
  'H'  -2.3  -3.9   0.0   1
  'H'   2.3  -3.9   0.0   1
/

!*********************************************************************************!
! COMMENTS FOR C6H6 CD-RI (RECOMMENDED):
!
! 🏆 This is the PREFERRED configuration for C6H6 testing!
!
! Key Differences vs Plan C:
!   yn_hse_cd_ri = 'y'  → Enables Cholesky decomposition
!   hse_cd_ri_threshold = 1.0d-8  → Controls numerical precision
!
! Memory Reduction:
!   Plan C (RI/DF):     V_PQ matrix = 126 × 126 = ~63 KB
!   CD-RI:              L_P matrix  = 126 × ~50 = ~25 KB (60% reduction)
!
!   For larger systems:
!   Si64 (Plan C):      V_PQ = 9600 × 9600 → 738 MB
!   Si64 (CD-RI):       L_P = 9600 × 3000  → 148 MB (80% reduction!)
!
! Performance vs Memory Trade-off:
!   - Computation: ~2% slower than Plan C (Cholesky overhead)
!   - Memory: 50-70% reduction
!   - For large systems (Si64+), CD-RI is MUCH faster (fitting in memory!)
!
! Cholesky Decomposition Details:
!   V_PQ ≈ Σ_K L_P,K * L_Q,K
!
!   Threshold controls:
!   1.0d-6: ~N_chol = 0.2 * N_aux (fast, lower accuracy)
!   1.0d-8: ~N_chol = 0.3 * N_aux (recommended) ← THIS
!   1.0d-10: ~N_chol = 0.5 * N_aux (high accuracy, slower)
!
! Expected Results:
!   - Memory usage should be ~50% of Plan C
!   - Energy should match Plan C to <0.0001 a.u.
!   - Step timing should be ~80% of Plan C (slightly faster due to smaller matrix)
!
! For Quick Test:
!   - nt = 20 (faster)
!   - dl = 0.7 (coarser grid)
!   - hse_cd_ri_threshold = 1.0d-6 (faster Cholesky decomposition)
!
!*********************************************************************************!
