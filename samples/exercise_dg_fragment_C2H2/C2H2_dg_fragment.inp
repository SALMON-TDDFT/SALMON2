!------------------------------------------------------------------------
! DG-Fragment RT-TDDFT Sample Input: C2H2 with Intense Laser Pulse
!------------------------------------------------------------------------
! This is a two-step calculation:
! 1. Ground state with DC-LCFO (generates fragment basis)
! 2. Real-time propagation with DG-Fragment method
!------------------------------------------------------------------------

!========================================================================
! STEP 1: Ground State Calculation with DC-LCFO
!========================================================================
! Run this first:  mpirun -np 4 salmon < gs_C2H2_dc.inp
! Output: out_frag_*/frag_XXXXXX/wf_XXXXXX.bin
!------------------------------------------------------------------------

&calculation
  theory = 'dft'
  yn_dc = 'y'
/

&control
  sysname = 'C2H2'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  iperiodic = 0
  al = 16.0, 16.0, 16.0   ! Angstrom
  nstate = 10
  nelec = 10
  nelem = 2
  natom = 4
/

&pseudo
  file_pseudo(1) = './C_rps.dat'
  file_pseudo(2) = './H_rps.dat'
  izatom(1) = 6
  izatom(2) = 1
  psmask_option(1:2) = 'y'
/

&atomic_coor
  'C'  0.0  0.0  0.60  1
  'C'  0.0  0.0 -0.60  1
  'H'  0.0  0.0  1.66  2
  'H'  0.0  0.0 -1.66  2
/

&rgrid
  dl = 0.25, 0.25, 0.25
/

&scf
  method_min = 'cg'
  ncg = 500
  threshold = 1.0e-9
/

&dg_fragment
  num_fragment = 2       ! Divide system into 2 fragments
  nstate_frag = 10       ! 10 states per fragment (should cover occupied+virtual)
/


!========================================================================
! STEP 2: Real-Time Propagation with DG-Fragment
!========================================================================
! Run after Step 1:  mpirun -np 4 salmon < rt_C2H2_dg.inp
!------------------------------------------------------------------------

&calculation
  theory = 'tddft_pulse'
  yn_dg_fragment_rt = 'y'
  yn_conventional_from_dcdft = 'y'
/

&control
  sysname = 'C2H2'
/

&units
  unit_system = 'A_eV_fs'
/

&system
  iperiodic = 0
  al = 16.0, 16.0, 16.0
  nstate = 10
  nelec = 10
  nelem = 2
  natom = 4
/

&pseudo
  file_pseudo(1) = './C_rps.dat'
  file_pseudo(2) = './H_rps.dat'
  izatom(1) = 6
  izatom(2) = 1
  psmask_option(1:2) = 'y'
/

&atomic_coor
  'C'  0.0  0.0  0.60  1
  'C'  0.0  0.0 -0.60  1
  'H'  0.0  0.0  1.66  2
  'H'  0.0  0.0 -1.66  2
/

&rgrid
  dl = 0.25, 0.25, 0.25
/

&tgrid
  nt = 20000
  dt = 0.08   ! fs
/

&dg_fragment
  num_fragment = 2              ! Must match Step 1
  nstate_frag = 10              ! Must match Step 1
  
  ! Adaptive basis update (optional but recommended)
  yn_adaptive_basis = 'y'
  basis_update_threshold = 0.1   ! eV
  
  ! Time integrator (optional)
  time_integrator_dg_fragment = 'rk4'     ! 'rk4', 'ssprk3', 'aetrs'
  
  ! Basis update method (NEW parameter)
  yn_dc_cg_basis_update = 'y'  ! 'y': DC-CG method (recommended)
                                ! 'n': simple diagonalization
/

&emfield
  ae_shape1 = 'Acos2'
  E_amplitude1 = 0.01      ! eV/Angstrom
  I_wcm2_1 = 1.0e12        ! W/cm^2
  tw1 = 6.0                ! fs (pulse width)
  omega1 = 1.55            ! eV (800 nm laser)
  epdir_re1 = 0.0, 0.0, 1.0
  phi_cep1 = 0.0
/

&analysis
  yn_out_psi = 'n'
  yn_out_dos = 'y'
  yn_out_pdos = 'y'
  yn_out_elf = 'n'
/

&poisson
  layout_multipole = 3
/
