&calculation
  theory='dft_md'
/

&control
  sysname = 'H2O'
  write_gs_restart_data='no'
/

&units
  unit_system='A_eV_fs'
/

&system
  yn_periodic = 'y'
  al = 5.0d0, 5.0d0, 5.0d0
  nstate = 4
  nelec  = 8
  nelem  = 2
  natom  = 3
/


&pseudo
  iZatom(1)=1
  file_pseudo(1) = './H_rps.dat'
  Lloc_ps(1)=1
  iZatom(2)=8
  file_pseudo(2) = './O_rps.dat'
  Lloc_ps(2)=1
/

&functional
  xc ='pbeh40_rvv10'
  rvv10_nq=32
  hse_mlwf_maxiter=20
  hse_mlwf_interval=5
/

&rgrid
  num_rgrid = 24,24,24
/

&kgrid
  num_kgrid=1,1,1
/


&scf
  nscf = 500
  threshold=1d-10
/

&atomic_coor
  'H'      3.55908403      2.48190608      2.50003451  1
  'H'      2.48189998      3.55908246      2.50002600  1
  'O'      2.61768087      2.61768023      2.49992927  2
/


&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
/

&tgrid
 dt=.05
 nt=8
/
&md
 ensemble='NVE'
 yn_set_ini_velocity='y'
 temperature0_ion_k=300
 step_update_ps=1
/
&analysis
 yn_out_rvf_rt='y'
 out_rvf_rt_step=1
/
