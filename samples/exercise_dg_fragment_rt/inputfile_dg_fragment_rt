!----------------------------------------------------------------------
! Sample input file for DG-Fragment RT-TDDFT calculation
!
! Prerequisites:
!   1. Run DC-LCFO calculation first to generate fragment basis data
!      in ./data_dcdft/ directory
!   2. Fragment basis data should contain wavefunctions.bin,
!      basis_functions.bin, and rgrid_index.bin for each fragment
!
! This calculation performs real-time TDDFT time evolution
! in the fragment basis coefficient space using Discontinuous Galerkin method
!----------------------------------------------------------------------

&calculation
  theory = 'tddft_pulse'
/

&control
  sysname = 'DG_Fragment_RT'
/

&parallel
  nproc_k = 1
  nproc_ob = 4
  nproc_rgrid = 2,2,2
  num_fragment = 2,2,2  ! must match DC-LCFO calculation
  ! 
  ! Hybrid MPI+OpenMP parallelization strategy:
  ! - MPI: Fragments are distributed across MPI processes
  !        Each rank calculates only its assigned fragments
  !        Each rank reads only its fragment data files (parallel I/O)
  !        Example: 8 fragments on 4 ranks -> 2 fragments/rank
  ! - OpenMP: Inner loops (orbitals, matrix elements) parallelized with OMP
  !           Set OMP_NUM_THREADS environment variable (e.g., export OMP_NUM_THREADS=4)
  ! 
  ! Optimal configuration:
  ! - Total cores = nproc_total * OMP_NUM_THREADS
  ! - nproc_total should be <= product(num_fragment) for load balancing
  ! - Example: 8 fragments, 32 cores -> 8 MPI ranks x 4 OpenMP threads
  !
/

&system
  yn_periodic = 'y'
  al = 10.0d0, 10.0d0, 10.0d0
  nstate = 128           ! total number of states
  nelem = 2
  natom = 32
/

&pseudo
  iZatom(1) = 14
  file_pseudo(1) = './Si_rps.dat'
  Lloc_ps(1) = 1
  iZatom(2) = 8
  file_pseudo(2) = './O_rps.dat'
  Lloc_ps(2) = 1
/

&functional
  xc = 'PZ'
/

&rgrid
  dl = 0.25d0, 0.25d0, 0.25d0
/

&tgrid
  nt = 5000              ! number of time steps
  dt = 0.08d0            ! time step [a.u.]
/

&propagation
  yn_dg_fragment_rt = 'y'           ! Enable DG-Fragment RT method
  time_integrator_dg_fragment = 'ssprk3'  ! 'ssprk3', 'rk4', or 'aetrs'
  propagator = 'middlepoint'        ! used for standard RT if yn_dg_fragment_rt='n'
/

&emfield
  ae_shape1 = 'Acos2'
  epdir_re1 = 1.0d0, 0.0d0, 0.0d0   ! polarization direction
  I_wcm2_1 = 1.0d12                 ! intensity [W/cm^2]
  omega1 = 0.05d0                   ! photon energy [a.u.]
  tw1 = 441.195d0                   ! pulse duration [a.u.]
  phi_cep1 = 0.75d0                 ! carrier envelope phase [*pi]
/

&analysis
  yn_out_psi = 'n'
  yn_out_dns = 'n'
  yn_out_dos = 'n'
/

&atomic_red_coor
  ! Atomic coordinates should be specified here
  ! or read from file
/

!----------------------------------------------------------------------
! Notes on DG-Fragment RT method:
!
! 1. Velocity gauge formulation:
!    - Uses vector potential A(t) instead of electric field E(t)
!    - Time-dependent Hamiltonian: H(t) = H_0 + A(t)·p + A(t)^2/2
!    - The A^2/2 term is the paramagnetic contribution (essential!)
!    - More suitable for strong-field and non-perturbative regime
!    - Complex coefficients for proper phase evolution: c(t) = |c|exp(i\u03c6)
!
! 2. Time integrators:
!    - 'ssprk3': Strong Stability Preserving Runge-Kutta 3rd order
!                (Recommended for most cases, stable and accurate)
!    - 'rk4':    Classical Runge-Kutta 4th order
!                (Higher accuracy but may require smaller dt)
!    - 'aetrs':  Enforced Time-Reversal Symmetry
!                (Preserves symmetry, experimental in fragment basis)
!
! 3. The method performs time evolution directly in the fragment
!    basis coefficient space without expanding to real-space grid,
!    which can be much more efficient for large systems.
!
! 4. Observables:
!    - Current density: j = <ψ|p|ψ> calculated from momentum matrix
!    - Total energy: E = <ψ|H(t)|ψ> including field interaction
!    - Dipole moment: d = <ψ|r|ψ> calculated from position matrix
!    - All computed from fragment basis coefficients
!
! 5. Current implementation status:
!    - Time evolution: IMPLEMENTED (SSPRK3/RK4 with velocity gauge)
!    - Complex coefficients: IMPLEMENTED (proper quantum phase evolution)
!    - Current and energy output: IMPLEMENTED
!    - Self-consistent update: ARCHITECTURE COMPLETE
!      * 4-step update procedure fully implemented
!      * Requires fragment basis function data integration
!      * Essential for photovoltaics, catalysis, laser excitation
!    - Control: yn_fix_func='y' (fixed H0) or 'n' (self-consistent)
!    - Suitable for linear response (fixed) and strong-field (self-consistent)
!
! 6. Output files are similar to standard RT-TDDFT but calculated
!    in fragment basis representation with velocity gauge.
!----------------------------------------------------------------------
