&calculation
  theory = 'tddft_pulse'
/
&control
  sysname = 'c64_dg_rt_pw_smoke'
/
&units
  unit_system = 'a.u.'
/
&dc
  num_fragment(1:3) = 2,2,2
  num_rgrid_buffer(1:3) = 6,6,6
  nproc_rgrid_tot(1:3) = 2,2,2
  nstate_frag = 400
  yn_dg_fragment_from_dcdft = 'y'
/
&parallel
  nproc_k = 1
  nproc_ob = 1
  nproc_rgrid(1:3) = 1,1,1
  process_allocation = 'orbital_sequential'
/
&system
  yn_periodic = 'y'
  al = 13.44d0, 13.44d0, 13.44d0
  nelem = 1
  nstate = 256
  nelec = 256
  natom = 64
  file_atom_coor = 'atom.dat'
  temperature_k = 300.0d0
/
&pseudo
  izatom(1) = 6
  file_pseudo(1) = '../../exercise_01_C2H2_gs/C_rps.dat'
  lloc_ps(1) = 1
/
&functional
  xc = 'PZ'
/
&rgrid
  num_rgrid(1:3) = 32,32,32
/
&kgrid
  num_kgrid(1:3) = 1,1,1
/
&tgrid
  nt = 2
  dt = 0.02d0
/
&propagation
  propagator = 'middlepoint'
  yn_dg_fragment_rt = 'y'
!  yn_dg_length_gauge = 'y'
!  time_integrator_dg_fragment = 'rk4'
  time_integrator_dg_fragment = 'taylor4pc'
  yn_plane_wave_basis = 'y'
  n_plane_waves_dg = 8
  k_cutoff_plane_wave = 0.5d0
  yn_dg_subspace_diag = 'y'
  dg_subspace_extra_states = 8
  dg_subspace_pw_vectors = 4
/
&scf
  ncg = 5
/
&emfield
  trans_longi = 'tr'
  ae_shape1 = 'impulse'
  epdir_re1 = 0.0d0, 0.0d0, 1.0d0
/
&analysis
  yn_out_psi = 'n'
  yn_out_dns = 'n'
  yn_out_dos = 'n'
  yn_out_pdos = 'n'
  yn_out_elf = 'n'
  yn_out_rvf_rt = 'n'
/
&dg_fragment
  yn_dg_frag = 'y'
  eps_dg_frag = 1.0d-10
  yn_dg_fragment_rt = 'y'
  yn_dg_fragment_from_dcdft = 'y'
  niter_dg_frag_rt_max = 0
/
