! Starting mesh/pulse for a matched RT comparison, NOT a converged Ni benchmark.
! Supply an existing, compatible checkpoint at the marked directory.
! Match that checkpoint's geometry/grid/kpoints/bands/occupations exactly.
&calculation
 theory='tddft_pulse'
/
&control
 sysname='Ni_lsda'
 directory_read_data='REPLACE_WITH_EXISTING_lsda_CHECKPOINT/'
/
&units
 unit_system='A_eV_fs'
/
&system
 yn_periodic='y', spin='noncollinear', yn_spinorbit='y', yn_symmetry='n'
 al=3.52d0,3.52d0,3.52d0
 nelem=1,natom=4,nelec=64,nstate=64
/
&pseudo
 file_pseudo(1)='/Users/otobetoshihito/Library/CloudStorage/OneDrive-qst.go.jp/calc2026/ni-soc-nlcc-20261024/v2-aux-pauli-validated/Ni/Ni_soc_nlcc_rps.dat'
 izatom(1)=28,lloc_ps(1)=0
/
&functional
 xc='pz'
/
&rgrid
 num_rgrid=24,24,24
/
&kgrid
 num_kgrid=4,4,4
/
&tgrid
 dt=0.001d0,nt=20000
/
&propagation
 propagator='middlepoint',yn_predictor_corrector='y',yn_fix_func='n'
/
&emfield
 ae_shape1='Acos2',I_wcm2_1=1.0d11,tw1=10d0,omega1=1.55d0
 epdir_re1=1d0,0d0,0d0
/
&atomic_red_coor
 'Ni' 0d0 0d0 0d0 1
 'Ni' 0d0 .5d0 .5d0 1
 'Ni' .5d0 0d0 .5d0 1
 'Ni' .5d0 .5d0 0d0 1
/
