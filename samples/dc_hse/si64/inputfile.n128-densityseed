&calculation
 theory='dft'
 yn_dc='y'
/
&control
 sysname='si64_dc_hse'
 write_gs_restart_data='yes'
 checkpoint_interval=10
 time_shutdown=600d0
/
&units
 unit_system='a.u.'
/
&dc
 num_fragment=2,2,2
 num_rgrid_buffer=6,6,6
 nproc_rgrid_tot=2,2,2
 nstate_frag=128
 yn_dc_lcfo='n'
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
 yn_eigenexa='n'
 yn_scalapack='n'
/
&system
 yn_periodic='y'
 al=20.52d0,20.52d0,20.52d0
 nelem=1
 nstate=256
 nelec=256
 natom=64
 file_atom_coor='atom.dat'
 temperature_k=300d0
/
&pseudo
 izatom(1)=14
 file_pseudo(1)='Si_rps.dat'
 lloc_ps(1)=2
/
&functional
 xc='hse06'
 hse_mlwf_maxiter=1
 hse_mlwf_interval=10000
/
&rgrid
 num_rgrid=32,32,32
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 nscf_init_redistribution=0
 nscf_init_no_diagonal=0
 nscf=100
 ncg=20
 method_mixing='broyden'
 alpha_mb=0.1d0
 method_init_density='read_dns_cube'
 threshold=1d-7
 yn_preconditioning='y'
/
