&calculation
 theory='dft'
 yn_dc='y'
/
&control
 sysname='si64_dc_hse'
 write_gs_restart_data='yes'
 time_shutdown=300d0
/
&units
 unit_system='a.u.'
/
&dc
 num_fragment=8,1,1
 num_rgrid_buffer=8,0,0
 nproc_rgrid_tot=8,1,1
 nstate_frag=64
 yn_dc_lcfo='n'
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
 yn_eigenexa='n'
 yn_scalapack='n'
/
&system
 yn_periodic='y'
 al=82.08d0,10.26d0,10.26d0
 nelem=1
 nstate=256
 nelec=256
 natom=64
 file_atom_coor='atom.dat'
 temperature_k=300d0
/
&pseudo
 izatom(1)=14
 file_pseudo(1)='Si_rps.dat'
 lloc_ps(1)=2
/
&functional
 xc='hse06'
 hse_mlwf_maxiter=1
 hse_mlwf_interval=10000
/
&rgrid
 num_rgrid=128,16,16
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 nscf_init_redistribution=10
 nscf_init_no_diagonal=0
 nscf=20
 ncg=5
 method_mixing='simple'
 mixrate=0.2d0
 threshold=1d-7
 yn_preconditioning='y'
/
