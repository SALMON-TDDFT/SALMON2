! Si diamond: 4x4x4 conventional cubic cells, 512 atoms, 2048 valence electrons.
! DC-SCF -> LCFO export for a later native real-space RT calculation.
! Launch with 64 MPI ranks; each fragment has one MPI rank.
&calculation
 theory='dft'
 yn_dc='y'
/
&control
 sysname='Si512_hse06_dc'
 yn_restart='n'
 write_gs_restart_data='no'
/
&units
 unit_system='a.u.'
/
&dc
 num_fragment=4,4,4
 num_rgrid_buffer=8,8,8
 nproc_rgrid_tot=4,4,4
 nstate_frag=256
 yn_dc_lcfo='y'
 yn_dc_lcfo_diag='y'
 yn_out_dc_fragment_coor='y'
 lcfo_eigensolver='chefsi'
 lcfo_diag_chefsi_filter_degree=60
 lcfo_diag_chefsi_max_cycle=200
 lcfo_diag_chefsi_residual_tolerance=1d-7
 energy_cut=100d0
 lambda_cut=1d-7
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
 yn_eigenexa='n'
 yn_scalapack='n'
/
&system
 yn_periodic='y'
 al=41.04d0,41.04d0,41.04d0
 nelem=1
 natom=512
 nelec=2048
 nstate=2048
 temperature_k=300d0
/
&pseudo
 izatom(1)=14
 file_pseudo(1)='Si_rps.dat'
 lmax_ps(1)=2
 lloc_ps(1)=2
/
&functional
 xc='hse06'
 hse_omega=0.11d0
 yn_exx_dc_mlwf='n'
 exx_mlwf_radius=0d0
 exx_mlwf_norm_fraction=0d0
 exx_pair_screening='off'
 exx_pre_scf_threshold=1d-4
 exx_pre_scf_steps=3
/
&rgrid
 num_rgrid=64,64,64
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 nscf=1800
 ncg=4
 threshold=1d-8
 convergence='rho_dne'
 nscf_init_redistribution=0
 nscf_init_no_diagonal=0
 method_mixing='broyden'
 mixrate=0.3d0
 alpha_mb=0.3d0
 yn_preconditioning='y'
/
