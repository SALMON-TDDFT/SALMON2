&calculation
 theory='tddft_pulse'
 yn_dc='n'
 yn_conventional_from_dcdft='y'
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,2,2
 yn_ffte='y'
/
&control
 sysname='h2'
 write_gs_restart_data='no'
/
&units
 unit_system='a.u.'
/
&system
 yn_periodic='y'
 al=64d0,16d0,16d0
 nstate=32
 nelec=64
 nelem=1
 natom=64
/
&pseudo
 izatom(1)=1
 file_pseudo(1)='H_rps.dat'
 lmax_ps(1)=1
 lloc_ps(1)=1
/
&functional
 exx_mlwf_norm_fraction=0.999d0
 exx_local_fft='auto'
 exx_ace_support='source'
 xc='pbe0'
 pbeh_coulomb_radius=4d0
 exx_mlwf_radius=0d0
 exx_mlwf_tolerance=1d-6
 yn_hse_wannier='y'
 exx_mlwf_interval=5
 exx_mlwf_maxiter=1000
/
&rgrid
 num_rgrid=128,32,32
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 method_init_wf='gauss10'
 alpha_mb=0.1d0
 nscf=2000
 ncg=4
 threshold=1d-10
 nscf_init_redistribution=0
 nscf_init_no_diagonal=0
/
