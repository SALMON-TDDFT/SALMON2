! Fixed 4^3 k grid for initial analysis; no k-point convergence scan.
&calculation
  theory='tddft_response'
/

&control
  sysname = 'Si'
  directory_read_data='../gs/data_for_restart/'
  checkpoint_interval=100
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 16
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = '../Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'hse06'
/

&rgrid
  dl = 0.855d0, 0.855d0, 0.855d0
/

&kgrid
  num_kgrid = 4, 4, 4
/

&tgrid
  nt = 100
  dt = 0.16
/

&scf
  ncg = 4
  nscf = 1
  threshold = 1.d-9
/

&emfield
  trans_longi = 'tr'
  e_impulse=0.0001
  ae_shape1 = 'impulse'
  epdir_re1 = 0., 0., 1.
/

&analysis
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	2.565	2.565	2.565	1
  'Si'	5.13	.0	5.13	1
  'Si'	.0	5.13	5.13	1
  'Si'	5.13	5.13	.0	1
  'Si'	7.695	2.565	7.695	1
  'Si'	2.565	7.695	7.695	1
  'Si'	7.695	7.695	2.565	1
/

&parallel
 nproc_k=8
 nproc_ob=1
 nproc_rgrid=1,1,1
/
! HSE defaults to Taylor4 + ACE; no propagation namelist is needed.
