&calculation
 theory='tddft_pulse'
/
&control
 sysname='Si',directory_read_data='../gs/data_for_restart/'
 checkpoint_interval=0,yn_self_checkpoint='n'
/
&units
 unit_system='a.u.'
/
&parallel
 nproc_k=8,nproc_ob=1,nproc_rgrid=1,1,1
/
&system
 yn_periodic='y',nstate=4,nelec=8,nelem=1,natom=2
 al_vec1=5.13,5.13,0
 al_vec2=0,5.13,5.13
 al_vec3=5.13,0,5.13
/
&pseudo
 izatom(1)=14,file_pseudo(1)='./Si_rps.dat',lmax_ps(1)=2,lloc_ps(1)=2
/
&functional
 xc='tbmbj',kli_mode='hsex',yn_hsex_update_w='y'
 hsex_screen_step=800,hsex_screen_interval=800,hsex_w_solver='frozen'
 hsex_w_qgrid=8,8,8,hsex_w_boxes=6,hsex_w_cutoff=3d0,hsex_w_eta=0.01
 hsex_frozen_rank=1728,hsex_frozen_tol=1d-6,hsex_frozen_qpoint=1,0,0
 yn_hsex_frozen_reference='n',yn_hsex_frozen_optical='n',hsex_frozen_gamma='q2'
 hsex_w_head_tol=.05d0,hsex_w_eta_tol=.05d0
/
&rgrid
 num_rgrid=12,12,12
/
&kgrid
 num_kgrid=8,8,8
/
&tgrid
 nt=1600,dt=0.0516767166707017,gram_schmidt_interval=10
/
&propagation
 propagator='middlepoint',yn_predictor_corrector='y'
/
&emfield
 trans_longi='tr',ae_shape1='Acos2'
 tw1=165.3654933462454,omega1=0.124947695397227,E_amplitude1=1d-6,phi_CEP1=0.25
 epdir_re1=0,0,1
/
&analysis
 projection_option='no'
/
&atomic_coor
 'Si' 0 0 0 1
 'Si' 2.565 2.565 2.565 1
/
