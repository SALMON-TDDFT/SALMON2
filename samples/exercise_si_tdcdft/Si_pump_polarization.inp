! EXPERIMENTAL instantaneous closure. Calibrate reference using strength=0 before interpretation.
! Polarization closure E_xc=alpha(t)*P, beta=gamma=0; experimental extension.
! Illustrative pump: 1.6 eV, 10 fs full envelope duration. Not calibrated.
&calculation
  theory='tddft_pulse'
/

&control
  sysname = 'Si'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 32
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = './Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
  tdcdft='lrc'
  tdcdft_alpha=0.2
  tdcdft_screening='polarization'
  tdcdft_screen_omega=0.05879892
  tdcdft_screen_reference=0.0 ! Placeholder, NOT a calibrated Si reference
  tdcdft_screen_strength=1.0
  tdcdft_screen_floor=1e-8
  tdcdft_damping=0.0
  tdcdft_restoring=0.0
/

&rgrid
  dl = 0.855d0, 0.855d0, 0.855d0
/

&kgrid
  num_kgrid = 4, 4, 4
/

&tgrid
  nt = 30000
  dt = 0.08
/

&scf
  ncg = 4
  nscf = 120
  threshold = 1.d-9
/

&emfield
  ae_shape1 = 'Acos2'
  tw1 = 413.413733
  omega1 = 0.05879892
  I_wcm2_1 = 1e10
  T1_T2 = 620.1205995
  e_impulse = 0.001
  trans_longi = 'tr'
  epdir_re1 = 0., 0., 1.
/

&analysis
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	2.565	2.565	2.565	1
  'Si'	5.13	.0	5.13	1
  'Si'	.0	5.13	5.13	1
  'Si'	5.13	5.13	.0	1
  'Si'	7.695	2.565	7.695	1
  'Si'	2.565	7.695	7.695	1
  'Si'	7.695	7.695	2.565	1
/
