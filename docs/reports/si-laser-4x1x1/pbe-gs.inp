&calculation
 theory='dft'
 yn_dc='y'
/
&control
 sysname='Si'
 yn_restart='n'
 write_gs_restart_data='no'
/
&units
 unit_system='a.u.'
/
&system
 yn_periodic='y'
 al=41.04d0,10.26d0,10.26d0
 nstate=128
 nelec=128
 natom=32
 temperature_k=300d0
 nelem=1
/
&pseudo
 izatom(1)=14
 file_pseudo(1)='Si_rps.dat'
 lmax_ps(1)=2
 lloc_ps(1)=2
/
&functional
 xc='libxc_pbe'
 
/
&rgrid
 num_rgrid=64,16,16
/
&kgrid
 num_kgrid=1,1,1
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
/
&scf
 nscf=1800
 method_mixing='broyden'
 mixrate=0.2d0
 alpha_mb=0.2d0
 yn_preconditioning='y'
 ncg=4
 threshold=1d-8
 nscf_init_no_diagonal=0
 nscf_init_redistribution=0
/
