&calculation
  theory='tddft_pulse'
/

&control
  sysname = 'Si'
  checkpoint_interval=2000
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 32
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = './Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
  tdcdft='proca'
  tdcdft_alpha=0.2
  tdcdft_screening='elf'
  tdcdft_elf_stride=10
  tdcdft_damping=0.0
  tdcdft_restoring=0.001
/

&rgrid
  dl = 0.855d0, 0.855d0, 0.855d0
/

&kgrid
  num_kgrid = 4, 4, 4
/

&tgrid
  nt = 5000
  dt = 0.08
/

&scf
  ncg = 4
  nscf = 120
  threshold = 1.d-9
/

&emfield
  ae_shape1 = 'Acos2'
  ae_shape2 = 'impulse'
  epdir_re2 = 0., 0., 1.
  T1_T2 = 50
  tw1 = 60
  omega1 = 0.2
  I_wcm2_1 = 10000000000000.0
  e_impulse = 0
  trans_longi = 'tr'
  epdir_re1 = 0., 0., 1.
/

&analysis
  projection_option='no'
  out_projection_step=200
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	2.565	2.565	2.565	1
  'Si'	5.13	.0	5.13	1
  'Si'	.0	5.13	5.13	1
  'Si'	5.13	5.13	.0	1
  'Si'	7.695	2.565	7.695	1
  'Si'	2.565	7.695	7.695	1
  'Si'	7.695	7.695	2.565	1
/
