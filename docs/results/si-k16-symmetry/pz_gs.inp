! 16^3 capacity pilot, fresh mesh, symmetry enabled.
&calculation
  theory='dft'
/

&control
  sysname = 'Si'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
 yn_symmetry='yyn'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 16
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = '/Users/otobetoshihito/Library/CloudStorage/OneDrive-qst.go.jp/SALMON-v.2.2.2/SALMON2/testsuites/pseudo/Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  dl = 0.855d0, 0.855d0, 0.855d0
/

&kgrid
  num_kgrid = 16, 16, 16
/

&tgrid
  nt = 3000
  dt = 0.16
/

&scf
  ncg = 4
  nscf = 200
  threshold = 1.d-9
/

&emfield
  trans_longi = 'lo'
  ae_shape1 = 'impulse'
  epdir_re1 = 0., 0., 1.
/

&analysis
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	2.565	2.565	2.565	1
  'Si'	5.13	.0	5.13	1
  'Si'	.0	5.13	5.13	1
  'Si'	5.13	5.13	.0	1
  'Si'	7.695	2.565	7.695	1
  'Si'	2.565	7.695	7.695	1
  'Si'	7.695	7.695	2.565	1
/

&parallel
 nproc_k=4
 nproc_ob=1
 nproc_rgrid=1,1,1
/
