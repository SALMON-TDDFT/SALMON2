! Fixed 4^3 k grid for initial analysis; no k-point convergence scan.
&calculation
  theory='tddft_response'
/

&control
  sysname = 'Si'
  directory_read_data='/Users/otobetoshihito/Library/CloudStorage/OneDrive-qst.go.jp/SALMON-v.2.2.2/SALMON2/calculations/si_tdcdft_k4/gs/data_for_restart/'
  checkpoint_interval=2
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 32
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = '/Users/otobetoshihito/Library/CloudStorage/OneDrive-qst.go.jp/SALMON-v.2.2.2/SALMON2/testsuites/pseudo/Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
 tdcdft='proca'
 tdcdft_alpha=0.2
 tdcdft_damping=0.0
 tdcdft_restoring=0.001
 tdcdft_screening='none'
/

&rgrid
  dl = 0.855d0, 0.855d0, 0.855d0
/

&kgrid
  num_kgrid = 4, 4, 4
/

&tgrid
  nt = 4
  dt = 0.08
/

&scf
  ncg = 4
  nscf = 1
  threshold = 1.d-9
/

&emfield
  trans_longi = 'tr'
  e_impulse=0.0001
  ae_shape1 = 'impulse'
  epdir_re1 = 0., 0., 1.
/

&analysis
 out_rt_energy_step=1
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	2.565	2.565	2.565	1
  'Si'	5.13	.0	5.13	1
  'Si'	.0	5.13	5.13	1
  'Si'	5.13	5.13	.0	1
  'Si'	7.695	2.565	7.695	1
  'Si'	2.565	7.695	7.695	1
  'Si'	7.695	7.695	2.565	1
/

&parallel
 nproc_k=4
 nproc_ob=1
 nproc_rgrid=1,1,1
/
&propagation
 n_hamil=4
 yn_predictor_corrector="y"
/
