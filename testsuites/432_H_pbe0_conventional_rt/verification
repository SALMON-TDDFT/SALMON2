#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
from pathlib import Path
import math
import re

text = Path('outputfile').read_text()
if not ('end SALMON' in text):
    print("Mismatch:", 'RT did not complete')
    sys.exit(-1)
if not ('DC-LCFO wavefunction reconstruction' not in text):
    print("Mismatch:", 'Unexpected DC reconstruction')
    sys.exit(-1)
if not ('Native LCFO RT active' not in text):
    print("Mismatch:", 'Expected native real-space propagation')
    sys.exit(-1)
for pattern, count in (('*_rt.data', 16), ('*_rt_energy.data', 17)):
    files = list(Path('.').glob(pattern))
    if not (len(files) == 1):
        print("Mismatch:", pattern)
        sys.exit(-1)
    rows = [list(map(float, line.split())) for line in files[0].read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    if not (len(rows) == count):
        print("Mismatch:", (pattern, len(rows)))
        sys.exit(-1)
    if not (all((math.isfinite(value) for row in rows for value in row))):
        print("Mismatch:", pattern)
        sys.exit(-1)
    if not (abs(rows[-1][0] - 0.32) < 1e-10):
        print("Mismatch:", 'Check failed: abs(rows[-1][0] - 0.32) < 1e-10')
        sys.exit(-1)
    if pattern == '*_rt.data':
        if not (all((len(row) >= 16 for row in rows))):
            print("Mismatch:", 'Check failed: all((len(row) >= 16 for row in rows))')
            sys.exit(-1)
        if not (max((abs(value) for row in rows for value in row[13:16])) > 1e-12):
            print("Mismatch:", 'No induced current')
            sys.exit(-1)
charges = re.findall(r'^\s*\d+\s+[\d.]+\s+\S+\s+\S+\s+\S+\s+(\S+)\s+\S+\s*$', text, re.M)
if not (charges and all((math.isfinite(float(value)) for value in charges))):
    print("Mismatch:", 'Missing electron norm')
    sys.exit(-1)
if not (max((abs(float(value) - 4.0) for value in charges)) < 1e-07):
    print("Mismatch:", 'Electron norm changed')
    sys.exit(-1)
print('Conventional hybrid GS to RT completed 16 steps with finite current/energy and conserved norm')

print("# Verification end")
print("#" * 60)
sys.exit(0)
