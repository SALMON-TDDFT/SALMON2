#!/usr/bin/env python3
from pathlib import Path
import math
import re

text = Path('outputfile').read_text()
assert 'end SALMON' in text, 'RT did not complete'
assert 'DC-LCFO wavefunction reconstruction' not in text, 'Unexpected DC reconstruction'
assert 'Native LCFO RT active' not in text, 'Expected native real-space propagation'
for pattern, count in (('*_rt.data', 16), ('*_rt_energy.data', 17)):
    files = list(Path('.').glob(pattern))
    assert len(files) == 1, pattern
    rows = [list(map(float, line.split())) for line in files[0].read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    assert len(rows) == count, (pattern, len(rows))
    assert all(math.isfinite(value) for row in rows for value in row), pattern
    assert abs(rows[-1][0] - .32) < 1e-10
    if pattern == '*_rt.data':
        assert all(len(row) >= 16 for row in rows)
        assert max(abs(value) for row in rows for value in row[13:16]) > 1e-12, 'No induced current'
charges = re.findall(r'^\s*\d+\s+[\d.]+\s+\S+\s+\S+\s+\S+\s+(\S+)\s+\S+\s*$', text, re.M)
assert charges and all(math.isfinite(float(value)) for value in charges), 'Missing electron norm'
assert max(abs(float(value) - 4.) for value in charges) < 1e-7, 'Electron norm changed'
print('Conventional hybrid GS to RT completed 16 steps with finite current/energy and conserved norm')
