#!/usr/bin/env python3
from pathlib import Path
import math
import re

text = Path('outputfile').read_text()
assert 'end SALMON' in text and '#GS converged at' in text, 'GS did not converge'
assert 'DC #SCF' not in text, 'Expected conventional GS'
for name in ('wfn.bin', 'occupation.bin', 'info.bin', 'hybrid_gs.bin'):
    assert (Path('data_for_restart') / name).stat().st_size > 0, name
print('Conventional hybrid GS converged and exported wavefunctions with metadata')
