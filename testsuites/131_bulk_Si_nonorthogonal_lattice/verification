#!/usr/bin/env python

# This verification script file is automatically executed after the SALMON.
# If necessary, this script file can used for the verification of the result.
# The script MUST indicate a "return-code 0", if the calculation is successful.
# If a negative value is returned, it is treated as a test failure.
 
import sys
import os
import re

print("#" * 60)
print("# Verification start")

filelist = [
    "Si_eigen.data",
    "Si_info.data",
]

# difference of eigen energies for io=1 and io=2 with ik=1"
reference_value_1 = 0.271266
permissible_error_1 = 0.00004 # (~0.001eV)

# difference of eigen energies for io=4 and io=5 with ik=2"
reference_value_2 = 0.114109
permissible_error_2 = 0.00004 # (~0.001eV)

# difference of total energy (eV)
reference_value_3 = -214.113848465987 # eV
permissible_error_3 = 0.001 # eV

print("# Checking the existance of outputfile")
for item in filelist:
    if not os.path.exists(item):
        print("File not found: %s" % item)
        sys.exit(-1)  # Failure

print("# Checking calculated result")

linecount = 0
for line in open("Si_eigen.data"):
    linecount += 1
    if linecount == 5: # line 5 (io=1, ik=1)
       data = line.split()
       v1 = float(data[1])
    if linecount == 6: # line 6 (io=2, ik=1)
       data = line.split()
       v2 = float(data[1])
    if linecount == 17: # line 17 (io=4, ik=2)
       data = line.split()
       v3 = float(data[1])
    if linecount == 18: # line 18 (io=5, ik=2)
       data = line.split()
       v4 = float(data[1])

diff1=v2-v1
diff2=v4-v3

if abs(diff1 - reference_value_1) > permissible_error_1:
        print("Mismatch |%e - %e| > %e)" % (diff1, reference_value_1, permissible_error_1))
        sys.exit(-1)  # Failure

if abs(diff2 - reference_value_2) > permissible_error_2:
        print("Mismatch |%e - %e| > %e)" % (diff2, reference_value_2, permissible_error_2))
        sys.exit(-1)  # Failure

linecount = 0
for line in open("Si_info.data"):
    linecount += 1
    if linecount == 6: # line 6
       data = line.split()
       etot = float(data[4])

if abs(etot - reference_value_3) > permissible_error_3:
        print("Mismatch of E_tot: |%e - %e| > %e)" % (etot, reference_value_3, permissible_error_3))
        sys.exit(-1)  # Failure

# Rounded CPU reference from the four-rank run. The forces are not zero because of the
# coarse grid; they come from the sum over the eight k-points in the non-orthogonal cell.
force_reference = (
    (-0.0122011, -0.0122011, -0.0122011),
    (-0.0103256, -0.0103256, -0.0103256),
)
force_tolerance = 4e-6  # a.u. (about 2e-4 eV/angstrom), per component

with open("Si_info.data") as info:
    for line in info:
        if line.strip() == "Force [au]":
            break
    else:
        sys.exit("Force [au] section not found in Si_info.data")

    for atom, reference in enumerate(force_reference, 1):
        fields = next(info, "").split()
        if len(fields) != 4 or fields[0] != str(atom):
            sys.exit("Missing or malformed force row for atom %d" % atom)
        try:
            force = tuple(float(value) for value in fields[1:])
        except ValueError:
            sys.exit("Invalid force value for atom %d" % atom)
        for axis, value, expected in zip("xyz", force, reference):
            if not abs(value - expected) <= force_tolerance:
                sys.exit(
                    "Force mismatch for atom %d (%s): %.8g vs %.8g a.u. (tolerance %.1g)"
                    % (atom, axis, value, expected, force_tolerance)
                )

print("Forces for both atoms match the reference.")
print("# Verification end")
print("#" * 60)

sys.exit(0)  # Success
