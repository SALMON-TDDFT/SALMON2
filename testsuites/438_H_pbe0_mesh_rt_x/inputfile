&calculation
 theory='tddft_response'
 yn_dc='n'
 yn_conventional_from_dcdft='y'
/
&dc
 num_fragment=2,1,1
 num_rgrid_buffer=4,0,0
 nproc_rgrid_tot=2,1,1
 nstate_frag=4
 yn_dc_lcfo='y'
 energy_cut=100d0
 lambda_cut=1d-7
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=2,1,1
/
&control
 sysname='H_dc_hse'
 write_gs_restart_data='no'
/
&units
 unit_system='a.u.'
/
&system
 yn_periodic='y'
 al=16d0,8d0,8d0
 nstate=2
 nelec=4
 nelem=1
 natom=4
/
&pseudo
 izatom(1)=1
 file_pseudo(1)='H_rps.dat'
 lmax_ps(1)=1
 lloc_ps(1)=1
/
&functional
 xc='pbe0'
 exx_ace_support='source'
 exx_mlwf_norm_fraction=.999d0
 exx_mlwf_interval=5
 exx_mlwf_maxiter=100
/
&rgrid
 num_rgrid=16,8,8
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 nscf=500
 ncg=4
 threshold=1d-10
 nscf_init_redistribution=0
 nscf_init_no_diagonal=0
/
&atomic_coor
 'H' 3.3d0 4d0 4d0 1
 'H' 4.7d0 4d0 4d0 1
 'H' 11.3d0 4d0 4d0 1
 'H' 12.7d0 4d0 4d0 1
/

&tgrid
 dt=.02d0
 nt=16
/
&emfield
 ae_shape1='impulse'
 e_impulse=1d-4
 epdir_re1=1,0,0
/
&analysis
 out_rt_energy_step=1
 nenergy=10
 de=.01
/
