#!/usr/bin/env python3
from math import isclose
from pathlib import Path
import re

log = Path('variables.log').read_text()
def value(key):
    return re.search(rf'#\s*{key}=\s*(\S+)', log)[1]

if 'end SALMON' not in Path('outputfile').read_text():
    raise SystemExit('incomplete input regression')
if value('kli_mode') != 'off' or value('yn_kli_rt_box_check') != 'y':
    raise SystemExit('case normalization failed')
# Explicit eV input and omitted (physical default) energy tolerance in Hartree.
for key, expected in [('kli_local_tol', 2e-5), ('kli_hartree_tol', 1e-3), ('kli_solve_tol', 1e-8)]:
    if not isclose(float(value(key)), expected, rel_tol=1e-12):
        raise SystemExit(f'{key}: expected {expected}, got {value(key)}')
