&calculation
  theory='dft'
/

&control
  sysname = 'Si'
/

&units
  unit_system = 'A_eV_fs'
/


&system
  yn_periodic = 'y'
  al_vec2 = 0.0, 2.71467909, 2.71467909
  al_vec3 = 2.71467909, 0.0, 2.71467909
  al_vec1 = 2.71467909, 2.71467909, 0.0
  nstate = 8
  nelec = 8
  nelem = 1
  natom = 2
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = './Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
  kli_mode = 'OfF'
  yn_kli_rt_box_check = 'Y'
  kli_local_tol = 0.000544227701
/

&rgrid
  num_rgrid = 6, 6, 6
/

&kgrid
  num_kgrid = 2, 2, 2
/

&tgrid
  nt = 3000
  dt = 0.16
/

&scf
  method_init_wf="random"
  yn_subspace_diagonalization='y'
  nscf_init_no_diagonal=0
  ncg = 4
  nscf = 2
  threshold = 1.d-9
/

&emfield
  trans_longi = 'lo'
  ae_shape1 = 'impulse'
  epdir_re1 = 0., 0., 1.
/

&analysis
  nenergy = 1000
  de = 0.001
/

&atomic_coor
  'Si'	.0	.0	.0	1
  'Si'	1.357339545	1.357339545	1.357339545	1
/
