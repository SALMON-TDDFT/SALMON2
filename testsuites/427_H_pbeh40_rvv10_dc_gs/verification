#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
from pathlib import Path
import re, math
s=Path('outputfile').read_text()
variables=Path('variables.log').read_text()
if not (re.search('# rvv10_fft=\\s*fftw\\b', variables)):
    print("Mismatch:", 'FFT backend was not normalized')
    sys.exit(-1)
if not (re.search('# hse_fft_layout=\\s*auto\\b', variables)):
    print("Mismatch:", 'FFT layout was not normalized')
    sys.exit(-1)
if not ('end SALMON' in s and 'end DC-LCFO complex' in s):
    print("Mismatch:", "Check failed: 'end SALMON' in s and 'end DC-LCFO complex' in s")
    sys.exit(-1)
rows=re.findall(r'DC #SCF.*diff =\s*(\S+)',s)
if not (rows and float(rows[-1]) < 1e-10):
    print("Mismatch:", 'Check failed: rows and float(rows[-1]) < 1e-10')
    sys.exit(-1)
records=[line.split() for line in s.splitlines() if line.split()[:3]==['DC','#SCF','=']]
if not (records and all((math.isfinite(float(row[7])) for row in records))):
    print("Mismatch:", 'Nonfinite SCF energy')
    sys.exit(-1)
eigen=Path('data_dcdft/total/H_dc_hse_lcfo_complex_eigen.data')
values=[float(line.split()[3]) for line in eigen.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith('#')]
# Gamma, one spin, four retained states: 1 * 1 * 4 eigenvalues.
if not (len(values) == 4 and all(map(math.isfinite, values))):
    print("Mismatch:", 'LCFO eigenvalues missing/nonfinite')
    sys.exit(-1)
files=list(Path('data_dcdft').rglob('functional.txt'))
if not (len(files) == 2):
    print("Mismatch:", 'Check failed: len(files) == 2')
    sys.exit(-1)
for p in files:
 lines=p.read_text().splitlines()
 if not (lines[0].strip() == 'SLCFO_FUNCTIONAL_V1'):
     print("Mismatch:", "Check failed: lines[0].strip() == 'SLCFO_FUNCTIONAL_V1'")
     sys.exit(-1)
 if not (lines[2].strip() == 'pbeh40_rvv10'):
     print("Mismatch:", "Check failed: lines[2].strip() == 'pbeh40_rvv10'")
     sys.exit(-1)
 v=list(map(float,lines[3].split()))
 if not (all(map(math.isfinite, v)) and v[0] == 0.4 and (v[1] == 0)):
     print("Mismatch:", 'Check failed: all(map(math.isfinite, v)) and v[0] == 0.4 and (v[1] == 0)')
     sys.exit(-1)
 if not (v[3:6] == [5.3, 0.0093, 32.0]):
     print("Mismatch:", 'Check failed: v[3:6] == [5.3, 0.0093, 32.0]')
     sys.exit(-1)
print('pbeh40_rvv10 DC GS converged with correct functional metadata')

print("# Verification end")
print("#" * 60)
sys.exit(0)
