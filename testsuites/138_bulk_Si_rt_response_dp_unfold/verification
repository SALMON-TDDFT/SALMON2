#!/usr/bin/env python

# This verification script file is automatically executed after the SALMON.
# If necessary, this script file can used for the verification of the result.
# The script MUST indicate a "return-code 0", if the calculation is successful.
# If a negative value is returned, it is treated as a test failure.
#
# With nt=10 and out_dm_unfold_step=10, dm_unfold() is called at itt=1 and
# itt=10 only (src/rt/time_evolution_step.f90 gates on
# itt==1 .or. itt==itotNtime .or. mod(itt,out_dm_unfold_step)==0), so
# Si_dm_unfold.data should contain exactly 2 data rows.
#
# NOTE: an earlier version of this script checked column 11
# ("Jz:<u[r,V]u>-d[a.u.]") against reference values measured with
# &unfolding/no_pr=16 in this test's inputfile. That was WRONG: no_pr is the
# number of primitive-cell bands used to expand the supercell orbitals
# (see unfolding.tex, the C_{n k-hat;mK} expansion), and needs to span the
# primitive-cell run's full band set (136's nstate=32), not just its
# occupied bands (16). With the too-small no_pr=16, the expansion basis was
# incomplete and "Tr[rho(t)]" (column 5) came out as ~14.6 instead of the
# physically-required ~32 (the primitive 8-atom cell's electron count) -
# caught by comparing against the expected electron count, not by a
# build-to-build CI mismatch. With no_pr corrected to 32, Tr[rho(t)] comes
# out right (~32), but column 11 itself turns out to be ~1e-11 - essentially
# numerical noise for this system - so it is no longer a suitable
# regression-check quantity. This version instead checks:
#   - Tr[rho(t)] (column 5): should stay close to 32, which directly guards
#     against a future no_pr misconfiguration reintroducing this bug.
#   - Jz:rho (column 29, "J:rho(t)<unk|i[h,r]|unk>" z-component printed to
#     stdout): the full physical current response, which is a well-behaved,
#     non-near-zero, meaningfully time-varying quantity for this system.
#
# Reference values below are taken from an actual run (1 node, 4 MPI
# processes) with &unfolding/no_pr=32.

import sys
import os

print("#" * 60)
print("# Verification start")

filelist = [
    "Si_dm_unfold.data",
]

print("# Checking the existance of outputfile")
for item in filelist:
    if not os.path.exists(item):
        print("File not found: %s" % item)
        sys.exit(-1)  # Failure

data_lines = [l for l in open("Si_dm_unfold.data") if not l.startswith("#")]

print("# Checking number of data rows (expect 2: itt=1 and itt=10)")
if len(data_lines) != 2:
    print("Unexpected number of data rows: %d (expected 2)" % len(data_lines))
    sys.exit(-1)  # Failure

print("# Checking calculated result")

tr_column = 4        # 0-indexed; column 5  = "Tr[rho(t)][none]"
jzrho_column = 28     # 0-indexed; column 29 = "Jz:rho[a.u.]"

tr1 = float(data_lines[0].split()[tr_column])    # itt=1  (t=0.16)
tr2 = float(data_lines[1].split()[tr_column])    # itt=10 (t=1.6)

v1 = float(data_lines[0].split()[jzrho_column])  # itt=1  (t=0.16)
v2 = float(data_lines[1].split()[jzrho_column])  # itt=10 (t=1.6)

# Tr[rho(t)] should stay close to the primitive-cell electron count (32).
# This is the check that catches a no_pr misconfiguration (an incomplete
# primitive-cell expansion basis systematically undercounts this trace).
reference_value_tr = 32.0
permissible_error_tr = 0.01

print("Tr[rho(t)] it=1  = %e (Reference = %e)" % (tr1, reference_value_tr))
if abs(tr1 - reference_value_tr) > permissible_error_tr:
    print("Mismatch |%e - %e| > %e)" % (tr1, reference_value_tr, permissible_error_tr))
    sys.exit(-1)  # Failure

print("Tr[rho(t)] it=10 = %e (Reference = %e)" % (tr2, reference_value_tr))
if abs(tr2 - reference_value_tr) > permissible_error_tr:
    print("Mismatch |%e - %e| > %e)" % (tr2, reference_value_tr, permissible_error_tr))
    sys.exit(-1)  # Failure

reference_value_1 = 0.000296171322    # v1 (itt=1), Jz:rho
permissible_error_1 = 1e-6

reference_value_2 = -0.000014095738   # v2 - v1
permissible_error_2 = 1e-7

print("v1 = %e (Reference = %e)" % (v1, reference_value_1))
if abs(v1 - reference_value_1) > permissible_error_1:
    print("Mismatch |%e - %e| > %e)" % (v1, reference_value_1, permissible_error_1))
    sys.exit(-1)  # Failure

diff = v2 - v1
print("v2 - v1 = %e (Reference = %e)" % (diff, reference_value_2))
if abs(diff - reference_value_2) > permissible_error_2:
    print("Mismatch |%e - %e| > %e)" % (diff, reference_value_2, permissible_error_2))
    sys.exit(-1)  # Failure

print("# Verification end")
print("#" * 60)

sys.exit(0)  # Success
