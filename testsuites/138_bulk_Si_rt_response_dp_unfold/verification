#!/usr/bin/env python

# This verification script file is automatically executed after the SALMON.
# If necessary, this script file can used for the verification of the result.
# The script MUST indicate a "return-code 0", if the calculation is successful.
# If a negative value is returned, it is treated as a test failure.
#
# With nt=10 and out_dm_unfold_step=10, dm_unfold() is called at itt=1 and
# itt=10 only (src/rt/time_evolution_step.f90 gates on
# itt==1 .or. itt==itotNtime .or. mod(itt,out_dm_unfold_step)==0), so
# Si_dm_unfold.data should contain exactly 2 data rows.
#
# Reference values below are taken from an actual run (1 node, 4 MPI
# processes). The checked quantity is column 11, "Jz:<u[r,V]u>-d[a.u.]"
# (0-indexed column 10) - the same column whose header label was fixed for
# a typo in dm_unfold.f90, so this also confirms the header/data column
# correspondence is intact, not just the numerical value.
#
# Two checks are used:
#   1. v1 (itt=1) against its reference value, with a loose absolute
#      tolerance (1e-8) - mainly catches gross errors.
#   2. v2 - v1 (the itt=1 -> itt=10 change) against its reference value,
#      with a tighter absolute tolerance (1e-10) - a differential check,
#      more sensitive to a broken time-evolution step, while staying
#      robust to a small overall offset in v1/v2 individually.

import sys
import os

print("#" * 60)
print("# Verification start")

filelist = [
    "Si_dm_unfold.data",
]

print("# Checking the existance of outputfile")
for item in filelist:
    if not os.path.exists(item):
        print("File not found: %s" % item)
        sys.exit(-1)  # Failure

data_lines = [l for l in open("Si_dm_unfold.data") if not l.startswith("#")]

print("# Checking number of data rows (expect 2: itt=1 and itt=10)")
if len(data_lines) != 2:
    print("Unexpected number of data rows: %d (expected 2)" % len(data_lines))
    sys.exit(-1)  # Failure

print("# Checking calculated result")

target_column = 10  # 0-indexed; column 11 = "Jz:<u[r,V]u>-d[a.u.]"

v1 = float(data_lines[0].split()[target_column])  # itt=1  (t=0.16)
v2 = float(data_lines[1].split()[target_column])  # itt=10 (t=1.6)

reference_value_1 = 0.000120743129    # v1 (itt=1)
permissible_error_1 = 1e-8

reference_value_2 = -0.000000057588   # v2 - v1
permissible_error_2 = 1e-10

print("v1 = %e (Reference = %e)" % (v1, reference_value_1))
if abs(v1 - reference_value_1) > permissible_error_1:
    print("Mismatch |%e - %e| > %e)" % (v1, reference_value_1, permissible_error_1))
    sys.exit(-1)  # Failure

diff = v2 - v1
print("v2 - v1 = %e (Reference = %e)" % (diff, reference_value_2))
if abs(diff - reference_value_2) > permissible_error_2:
    print("Mismatch |%e - %e| > %e)" % (diff, reference_value_2, permissible_error_2))
    sys.exit(-1)  # Failure

print("# Verification end")
print("#" * 60)

sys.exit(0)  # Success
