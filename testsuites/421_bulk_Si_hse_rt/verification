#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
"""Short impulse regression; the observation time does not resolve optical peaks."""
import math
import re
from pathlib import Path


def table(filename):
    rows = [list(map(float, line.split()))
            for line in Path(filename).read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    if not (rows and all((math.isfinite(x) for row in rows for x in row))):
        print("Mismatch:", filename)
        sys.exit(-1)
    return rows


text = Path('outputfile').read_text()
if not ('end SALMON' in text):
    print("Mismatch:", 'RT did not finish normally')
    sys.exit(-1)
variables = Path('variables.log').read_text().replace(' ', '')
if not ('propagator=hse_taylor4' in variables):
    print("Mismatch:", 'default HSE propagator changed')
    sys.exit(-1)
rt = table('Si_rt.data')
if not (len(rt) == 64 and all((len(row) == 16 for row in rt))):
    print("Mismatch:", 'Check failed: len(rt) == 64 and all((len(row) == 16 for row in rt))')
    sys.exit(-1)
for step, row in enumerate(rt, 1):
    if not (abs(row[0] - step * 0.16) < 1e-08):
        print("Mismatch:", 'Check failed: abs(row[0] - step * 0.16) < 1e-08')
        sys.exit(-1)
    if not (abs(row[3] - 0.0001) < 1e-12):
        print("Mismatch:", 'incorrect impulse amplitude')
        sys.exit(-1)
if not (max((abs(row[15]) for row in rt)) > 1e-08):
    print("Mismatch:", 'vanishing impulse response')
    sys.exit(-1)
if not (max((abs(row[15]) for row in rt)) < 0.0001):
    print("Mismatch:", 'unbounded current response')
    sys.exit(-1)
electrons = []
for line in text.splitlines():
    if re.match(r'^\s*\d+\s+\d+\.\d+\s+', line):
        fields = line.split()
        if len(fields) == 7:
            electrons.append(float(fields[5]))
if not (electrons and all((math.isfinite(x) and abs(x - 32) < 0.0001 for x in electrons))):
    print("Mismatch:", 'Check failed: electrons and all((math.isfinite(x) and abs(x - 32) < 0.0001 for x in electrons))')
    sys.exit(-1)
energy = table('Si_rt_energy.data')
if not (len(energy) == 65 and abs(energy[-1][0] - 10.24) < 1e-08):
    print("Mismatch:", 'Check failed: len(energy) == 65 and abs(energy[-1][0] - 10.24) < 1e-08')
    sys.exit(-1)
if not (max((abs(row[1] - energy[1][1]) for row in energy[1:])) < 1e-05):
    print("Mismatch:", 'post-kick energy drift')
    sys.exit(-1)
spectrum = table('Si_response.data')
if not (len(spectrum) == 1000 and all((len(row) == 13 for row in spectrum))):
    print("Mismatch:", 'Check failed: len(spectrum) == 1000 and all((len(row) == 13 for row in spectrum))')
    sys.exit(-1)
if not (all((abs(row[0] - i * 0.001) < 1e-08 for i, row in enumerate(spectrum, 1)))):
    print("Mismatch:", 'Check failed: all((abs(row[0] - i * 0.001) < 1e-08 for i, row in enumerate(spectrum, 1)))')
    sys.exit(-1)
# The native response output must obey eps = 1 + 4*pi*i*sigma/omega.
for row in spectrum:
    factor = 4 * math.pi / row[0]
    if not (math.isclose(row[9], 1 - factor * row[6], rel_tol=1e-09, abs_tol=1e-09)):
        print("Mismatch:", 'Check failed: math.isclose(row[9], 1 - factor * row[6], rel_tol=1e-09, abs_tol=1e-09)')
        sys.exit(-1)
    if not (math.isclose(row[12], factor * row[3], rel_tol=1e-09, abs_tol=1e-09)):
        print("Mismatch:", 'Check failed: math.isclose(row[12], factor * row[3], rel_tol=1e-09, abs_tol=1e-09)')
        sys.exit(-1)
print('Nk=4^3 HSE Taylor4+ACE impulse current, energy and dielectric output passed')

print("# Verification end")
print("#" * 60)
sys.exit(0)
