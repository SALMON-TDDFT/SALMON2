#!/usr/bin/env python3
from pathlib import Path
import math
text=Path('outputfile').read_text()
assert 'end SALMON' in text
assert 'hse_omega' in Path('variables.log').read_text()
assert Path('data_for_restart/wfn.bin').is_file()
rows=[line.split() for line in Path('Si_eigen.data').read_text().splitlines() if line.strip() and line.split()[0].isdigit()]
assert rows and all(math.isfinite(float(row[1])) for row in rows)
