#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
"""Require a converged, finite HSE GS before the impulse fixture may run."""
import math
import re
from pathlib import Path

text = Path('outputfile').read_text()
if not ('end SALMON' in text):
    print("Mismatch:", 'GS did not finish normally')
    sys.exit(-1)
match = re.search(r'#GS converged at\s+(\d+)\s+:\s*(\S+)', text)
if not (match):
    print("Mismatch:", 'HSE GS did not converge')
    sys.exit(-1)
if not (float(match[2]) < 1e-08):
    print("Mismatch:", 'GS density residual exceeds input tolerance')
    sys.exit(-1)
variables = Path('variables.log').read_text().replace(' ', '')
omega = re.search(r'hse_omega\(bohr\^-1\)=(\S+)', variables)
if not (omega and abs(float(omega[1]) - 0.11) < 1e-12):
    print("Mismatch:", 'Check failed: omega and abs(float(omega[1]) - 0.11) < 1e-12')
    sys.exit(-1)
if not (Path('data_for_restart/wfn.bin').stat().st_size > 0):
    print("Mismatch:", "Check failed: Path('data_for_restart/wfn.bin').stat().st_size > 0")
    sys.exit(-1)
rows = [line.split() for line in Path('Si_eigen.data').read_text().splitlines()
        if line.strip() and line.split()[0].isdigit()]
if not (rows and all((math.isfinite(float(row[1])) for row in rows))):
    print("Mismatch:", 'Check failed: rows and all((math.isfinite(float(row[1])) for row in rows))')
    sys.exit(-1)
krows = [line.split() for line in Path('Si_k.data').read_text().splitlines()
         if len(line.split()) == 5 and line.split()[0].isdigit()]
if not (len(krows) == 64):
    print("Mismatch:", 'Check failed: len(krows) == 64')
    sys.exit(-1)
if not (abs(sum((float(row[4]) for row in krows)) - 1) < 1e-12):
    print("Mismatch:", 'Check failed: abs(sum((float(row[4]) for row in krows)) - 1) < 1e-12')
    sys.exit(-1)
print('Converged HSE GS ready for Nk=4^3 impulse response')

print("# Verification end")
print("#" * 60)
sys.exit(0)
