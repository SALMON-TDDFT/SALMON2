#!/usr/bin/env python3
"""Require a converged, finite HSE GS before the impulse fixture may run."""
import math
import re
import os


def read_text(filename):
    with open(filename) as handle:
        return handle.read()


def isfinite(value):
    return not (math.isnan(value) or math.isinf(value))


text = read_text('outputfile')
assert 'end SALMON' in text, 'GS did not finish normally'
match = re.search(r'#GS converged at\s+(\d+)\s+:\s*(\S+)', text)
assert match, 'HSE GS did not converge'
assert float(match.group(2)) < 1e-8, 'GS density residual exceeds input tolerance'
variables = read_text('variables.log').replace(' ', '')
omega = re.search(r'hse_omega\(bohr\^-1\)=(\S+)', variables)
assert omega and abs(float(omega.group(1)) - .11) < 1e-12
assert os.path.getsize('data_for_restart/wfn.bin') > 0
rows = [line.split() for line in read_text('Si_eigen.data').splitlines()
        if line.strip() and line.split()[0].isdigit()]
assert rows and all(isfinite(float(row[1])) for row in rows)
krows = [line.split() for line in read_text('Si_k.data').splitlines()
         if len(line.split()) == 5 and line.split()[0].isdigit()]
assert len(krows) == 64
assert abs(sum(float(row[4]) for row in krows) - 1) < 1e-12
print('Converged HSE GS ready for Nk=4^3 impulse response')
