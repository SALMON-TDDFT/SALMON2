#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
from pathlib import Path
import math

text = Path('outputfile').read_text()
if not ('end SALMON' in text):
    print("Mismatch:", 'Calculation did not complete')
    sys.exit(-1)
if not ('end complex DC-LCFO wavefunction reconstruction' in text):
    print("Mismatch:", "Check failed: 'end complex DC-LCFO wavefunction reconstruction' in text")
    sys.exit(-1)
if not ('Native LCFO RT active' not in text):
    print("Mismatch:", 'Expected native mesh propagation')
    sys.exit(-1)

def read_rows(pattern, count):
    files = list(Path('.').glob(pattern))
    if not (len(files) == 1):
        print("Mismatch:", (pattern, files))
        sys.exit(-1)
    rows = [list(map(float, line.split())) for line in files[0].read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    if not (len(rows) == count):
        print("Mismatch:", (pattern, len(rows), count))
        sys.exit(-1)
    if not (all((math.isfinite(value) for row in rows for value in row))):
        print("Mismatch:", pattern)
        sys.exit(-1)
    if not (all((right[0] > left[0] for left, right in zip(rows, rows[1:])))):
        print("Mismatch:", pattern)
        sys.exit(-1)
    return rows

if not (text.count('EXX_SUPPORT_ACE accepted: T') == 33):
    print("Mismatch:", "Check failed: text.count('EXX_SUPPORT_ACE accepted: T') == 33")
    sys.exit(-1)
if not ('EXX_SUPPORT_ACE accepted: F' not in text):
    print("Mismatch:", "Check failed: 'EXX_SUPPORT_ACE accepted: F' not in text")
    sys.exit(-1)
current = read_rows('*_rt.data', 16)
energy = read_rows('*_rt_energy.data', 17)
if not (all((len(row) >= 16 for row in current))):
    print("Mismatch:", 'Check failed: all((len(row) >= 16 for row in current))')
    sys.exit(-1)
if not (max((abs(value) for row in current for value in row[13:16])) > 1e-12):
    print("Mismatch:", 'No induced current')
    sys.exit(-1)
if not (abs(current[-1][0] - 0.32) < 1e-10):
    print("Mismatch:", 'Check failed: abs(current[-1][0] - 0.32) < 1e-10')
    sys.exit(-1)
print('Native mesh RT completed 16 steps with finite current, energy, and source ACE')

print("# Verification end")
print("#" * 60)
sys.exit(0)
