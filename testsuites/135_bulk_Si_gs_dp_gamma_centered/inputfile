&calculation
  theory='dft'
/

&control
  sysname = 'Si'
/

&units
  unit_system = 'a.u.'
/

&system
  yn_periodic = 'y'
  al = 10.26d0, 10.26d0, 10.26d0
  nstate = 32
  nelec = 32
  nelem = 1
  natom = 8
/

&pseudo
  izatom(1) = 14
  file_pseudo(1) = './Si_rps.dat'
  lmax_ps(1) = 2
  lloc_ps(1) = 2
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 12, 12, 12
/

&kgrid
  num_kgrid = 2, 2, 2
  yn_gamma_centered = 'y'
/

&scf
  ncg = 4
  nscf = 120
  threshold = 1.d-9
/

&atomic_red_coor
  'Si'	0.00	0.00	0.00	1
  'Si'	0.25	0.25	0.25	1
  'Si'	0.50	0.00	0.50	1
  'Si'	0.00	0.50	0.50	1
  'Si'	0.50	0.50	0.00	1
  'Si'	0.75	0.25	0.75	1
  'Si'	0.25	0.75	0.75	1
  'Si'	0.75	0.75	0.25	1
/
