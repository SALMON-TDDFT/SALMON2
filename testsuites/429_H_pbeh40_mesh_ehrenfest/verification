#!/usr/bin/env python3
from pathlib import Path
import math

text = Path('outputfile').read_text()
assert 'end SALMON' in text, 'Calculation did not complete'
assert 'end complex DC-LCFO wavefunction reconstruction' in text
assert 'Native LCFO RT active' not in text, 'Expected native mesh propagation'

def read_rows(pattern, count):
    files = list(Path('.').glob(pattern))
    assert len(files) == 1, (pattern, files)
    rows = [list(map(float, line.split())) for line in files[0].read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    assert len(rows) == count, (pattern, len(rows), count)
    assert all(math.isfinite(value) for row in rows for value in row), pattern
    assert all(right[0] > left[0] for left, right in zip(rows, rows[1:])), pattern
    return rows

current = read_rows('*_rt.data', 2)
energy = read_rows('*_rt_energy.data', 3)
assert all(len(row) >= 16 for row in current)
assert max(abs(value) for row in current for value in row[13:16]) > 1e-12, 'No induced current'
assert max(row[3] for row in energy) > 0., 'Ionic kinetic energy stayed zero'
assert abs(current[-1][0] - .08) < 1e-10
files = list(Path('.').glob('*_trj.xyz'))
assert len(files) == 1
lines = files[0].read_text().splitlines()
frames = []
index = 0
while index < len(lines):
    assert int(lines[index]) == 4
    frame = []
    for line in lines[index + 2:index + 6]:
        coordinates = list(map(float, line.split()[1:4]))
        velocity = list(map(float, line.split('#v=')[1].split('#f=')[0].split()))
        force = list(map(float, line.split('#f=')[1].split()))
        assert len(coordinates) == len(velocity) == len(force) == 3
        assert all(math.isfinite(value) for value in coordinates + velocity + force)
        frame.extend(coordinates)
    assert len(frame) == 12
    frames.append(frame)
    index += 6
assert len(frames) == 3, len(frames)
assert max(abs(a - b) for a, b in zip(frames[-1], frames[0])) > 1e-9, 'Ions did not move'
print('Native mesh Ehrenfest completed two steps with finite current, energy, and moving ions')
