&calculation
 theory='dft'
 yn_dc='n'
/
&parallel
 nproc_k=1
 nproc_ob=1
 nproc_rgrid=1,1,1
 yn_ffte='y'
/
&control
 sysname='h2'
 write_gs_restart_data='no'
/
&units
 unit_system='a.u.'
/
&system
 yn_periodic='y'
 al=8d0,8d0,8d0
 nstate=1
 nelec=2
 nelem=1
 natom=2
/
&pseudo
 izatom(1)=1
 file_pseudo(1)='H_rps.dat'
 lmax_ps(1)=1
 lloc_ps(1)=1
/
&functional
 xc='pbeh40'
 pbeh_coulomb_radius=4d0
 exx_mlwf_radius=0d0
 exx_mlwf_tolerance=1d-7
 yn_hse_wannier='y'
 exx_mlwf_interval=5
 exx_mlwf_maxiter=100
/
&rgrid
 num_rgrid=16,16,16
/
&kgrid
 num_kgrid=1,1,1
/
&scf
 method_init_wf='gauss10'
 alpha_mb=0.1d0
 nscf=2000
 ncg=4
 threshold=1d-10
 nscf_init_redistribution=0
 nscf_init_no_diagonal=0
/
&atomic_coor
 'H' 3.3d0 4d0 4d0 1
 'H' 4.7d0 4d0 4d0 1
/
