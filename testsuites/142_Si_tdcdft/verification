#!/usr/bin/env python3
"""Validate finite, nonzero xc response and its equation of motion in a Si run."""
import math
from pathlib import Path

def rows(name):
    return [[float(x) for x in line.split()] for line in Path(name).read_text().splitlines()
            if line.strip() and not line.startswith('#')]

xc=rows('Si_rt_xc.data')
rt=rows('Si_rt.data')
assert abs(xc[0][3])>1e-10, 'initial half step missing'
assert len(xc)==180 and len(rt)==180, 'incomplete propagation'
assert all(math.isfinite(x) for row in xc+rt for x in row), 'nonfinite output'
assert max(abs(row[3]) for row in xc)>1e-7, 'xc coupling is absent'
for i in range(1,len(xc)-1):
    dt=xc[i][0]-xc[i-1][0]
    for d in range(3):
        residual=(xc[i+1][1+d]-2*xc[i][1+d]+xc[i-1][1+d])/dt**2
        residual+=0.01*xc[i][1+d]-0.2*rt[i][13+d]
        assert abs(residual)<1e-10, 'xc field/current equation mismatch'
    assert max(abs(rt[i][k]-rt[i][k-6]) for k in range(7,10))<1e-14, 'classical field contaminated'
print('Si Proca current, finite xc field and equation of motion verified')
