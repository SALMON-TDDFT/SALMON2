#!/usr/bin/env python3

# Verification follows the standard testsuite exit-code contract.
import sys
print("#" * 60)
print("# Verification start")
from pathlib import Path
import math

text = Path('outputfile').read_text()
if not ('end SALMON' in text):
    print("Mismatch:", 'Calculation did not complete')
    sys.exit(-1)
if not ('end complex DC-LCFO wavefunction reconstruction' in text):
    print("Mismatch:", "Check failed: 'end complex DC-LCFO wavefunction reconstruction' in text")
    sys.exit(-1)
if not ('Native LCFO RT active' not in text):
    print("Mismatch:", 'Expected native mesh propagation')
    sys.exit(-1)

def read_rows(pattern, count):
    files = list(Path('.').glob(pattern))
    if not (len(files) == 1):
        print("Mismatch:", (pattern, files))
        sys.exit(-1)
    rows = [list(map(float, line.split())) for line in files[0].read_text().splitlines()
            if line.strip() and not line.lstrip().startswith('#')]
    if not (len(rows) == count):
        print("Mismatch:", (pattern, len(rows), count))
        sys.exit(-1)
    if not (all((math.isfinite(value) for row in rows for value in row))):
        print("Mismatch:", pattern)
        sys.exit(-1)
    if not (all((right[0] > left[0] for left, right in zip(rows, rows[1:])))):
        print("Mismatch:", pattern)
        sys.exit(-1)
    return rows

current = read_rows('*_rt.data', 2)
energy = read_rows('*_rt_energy.data', 3)
if not (all((len(row) >= 16 for row in current))):
    print("Mismatch:", 'Check failed: all((len(row) >= 16 for row in current))')
    sys.exit(-1)
if not (max((abs(value) for row in current for value in row[13:16])) > 1e-12):
    print("Mismatch:", 'No induced current')
    sys.exit(-1)
if not (max((row[3] for row in energy)) > 0.0):
    print("Mismatch:", 'Ionic kinetic energy stayed zero')
    sys.exit(-1)
if not (abs(current[-1][0] - 0.08) < 1e-10):
    print("Mismatch:", 'Check failed: abs(current[-1][0] - 0.08) < 1e-10')
    sys.exit(-1)
files = list(Path('.').glob('*_trj.xyz'))
if not (len(files) == 1):
    print("Mismatch:", 'Check failed: len(files) == 1')
    sys.exit(-1)
lines = files[0].read_text().splitlines()
frames = []
index = 0
while index < len(lines):
    if not (int(lines[index]) == 4):
        print("Mismatch:", 'Check failed: int(lines[index]) == 4')
        sys.exit(-1)
    frame = []
    for line in lines[index + 2:index + 6]:
        coordinates = list(map(float, line.split()[1:4]))
        velocity = list(map(float, line.split('#v=')[1].split('#f=')[0].split()))
        force = list(map(float, line.split('#f=')[1].split()))
        if not (len(coordinates) == len(velocity) == len(force) == 3):
            print("Mismatch:", 'Check failed: len(coordinates) == len(velocity) == len(force) == 3')
            sys.exit(-1)
        if not (all((math.isfinite(value) for value in coordinates + velocity + force))):
            print("Mismatch:", 'Check failed: all((math.isfinite(value) for value in coordinates + velocity + force))')
            sys.exit(-1)
        frame.extend(coordinates)
    if not (len(frame) == 12):
        print("Mismatch:", 'Check failed: len(frame) == 12')
        sys.exit(-1)
    frames.append(frame)
    index += 6
if not (len(frames) == 3):
    print("Mismatch:", len(frames))
    sys.exit(-1)
if not (max((abs(a - b) for a, b in zip(frames[-1], frames[0]))) > 1e-09):
    print("Mismatch:", 'Ions did not move')
    sys.exit(-1)
print('Native mesh Ehrenfest completed two steps with finite current, energy, and moving ions')

print("# Verification end")
print("#" * 60)
sys.exit(0)
