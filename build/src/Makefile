	cd /workspace/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/salmon.dir/build.make src/CMakeFiles/salmon.dir/xc/salmon_xc.f90.o
.PHONY : xc/salmon_xc.f90.o

xc/salmon_xc.i: xc/salmon_xc.f90.i
.PHONY : xc/salmon_xc.i

# target to preprocess a source file
xc/salmon_xc.f90.i:
	cd /workspace/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/salmon.dir/build.make src/CMakeFiles/salmon.dir/xc/salmon_xc.f90.i
.PHONY : xc/salmon_xc.f90.i

xc/salmon_xc.s: xc/salmon_xc.f90.s
.PHONY : xc/salmon_xc.s

# target to generate assembly for a file
xc/salmon_xc.f90.s:
	cd /workspace/build && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/salmon.dir/build.make src/CMakeFiles/salmon.dir/xc/salmon_xc.f90.s
.PHONY : xc/salmon_xc.f90.s

