# Keep dependency builds local and use the selected target toolchain.
set(SALMON_EXTERNAL_CMAKE_ARGS
  -DCMAKE_BUILD_TYPE:STRING=Release
  -DCMAKE_INSTALL_LIBDIR:STRING=lib
  -DCMAKE_C_COMPILER:FILEPATH=${CMAKE_C_COMPILER}
  -DCMAKE_Fortran_COMPILER:FILEPATH=${CMAKE_Fortran_COMPILER}
  -DCMAKE_POLICY_VERSION_MINIMUM:STRING=3.5
  -DBUILD_SHARED_LIBS:BOOL=OFF)
foreach(_var CMAKE_TOOLCHAIN_FILE CMAKE_SYSROOT CMAKE_OSX_SYSROOT CMAKE_OSX_DEPLOYMENT_TARGET CMAKE_OSX_ARCHITECTURES CMAKE_C_COMPILER_TARGET CMAKE_Fortran_COMPILER_TARGET)
  if(DEFINED ${_var} AND NOT "${${_var}}" STREQUAL "")
    string(REPLACE ";" "|" _external_value "${${_var}}")
    list(APPEND SALMON_EXTERNAL_CMAKE_ARGS "-D${_var}:STRING=${_external_value}")
  endif()
endforeach()
