# Run before project(): the Fugaku login compiler is a cross compiler, so
# selecting it after language detection is too late. Never replace user choices.
if(NOT DEFINED SALMON_PLATFORM)
  set(SALMON_PLATFORM auto)
endif()
set(SALMON_PLATFORM "${SALMON_PLATFORM}" CACHE STRING "Platform selection: auto, fugaku, generic")
set_property(CACHE SALMON_PLATFORM PROPERTY STRINGS auto fugaku generic)
if(NOT SALMON_PLATFORM MATCHES "^(auto|fugaku|generic)$")
  message(FATAL_ERROR "SALMON_PLATFORM must be auto, fugaku or generic")
endif()
if(DEFINED CMAKE_TOOLCHAIN_FILE OR NOT "$ENV{CMAKE_TOOLCHAIN_FILE}" STREQUAL "")
  return()
endif()
if(SALMON_PLATFORM STREQUAL "generic")
  return()
endif()
if(DEFINED CMAKE_C_COMPILER OR DEFINED CMAKE_Fortran_COMPILER
   OR NOT "$ENV{CC}" STREQUAL "" OR NOT "$ENV{FC}" STREQUAL "")
  if(SALMON_PLATFORM STREQUAL "fugaku")
    message(FATAL_ERROR "SALMON_PLATFORM=fugaku conflicts with explicit CC/FC or CMake compilers; use the Fugaku toolchain explicitly or remove compiler overrides")
  endif()
  return()
endif()
if(SALMON_PLATFORM STREQUAL "auto" AND NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  return()
endif()
find_program(_salmon_fugaku_fc NAMES mpifrtpx)
find_program(_salmon_fugaku_cc NAMES mpifccpx)
if(_salmon_fugaku_fc AND _salmon_fugaku_cc)
  get_filename_component(_salmon_fugaku_toolchain
    "${CMAKE_CURRENT_LIST_DIR}/../platforms/fugaku.cmake" ABSOLUTE)
  set(CMAKE_TOOLCHAIN_FILE "${_salmon_fugaku_toolchain}" CACHE FILEPATH "SALMON selected Fugaku toolchain")
  message(STATUS "SALMON: selecting Fugaku MPI/HSE toolchain (${CMAKE_TOOLCHAIN_FILE})")
elseif(SALMON_PLATFORM STREQUAL "fugaku")
  message(FATAL_ERROR "SALMON_PLATFORM=fugaku requires mpifrtpx and mpifccpx on PATH; load the Fujitsu compiler environment")
endif()
unset(_salmon_fugaku_fc CACHE)
unset(_salmon_fugaku_cc CACHE)
