if (ARCH_FLAGS)
  message(STATUS "Specific architecture flags: ${ARCH_FLAGS}")
endif ()

if (OPENMP_FLAGS)
  message(STATUS "Specific OpenMP flags: ${OPENMP_FLAGS}")
else ()
  find_package(OpenMP REQUIRED)
  set(OPENMP_FLAGS ${OpenMP_C_FLAGS})
  if (OpenMP_C_FOUND)
    list(APPEND EXTERNAL_LIBS OpenMP::OpenMP_C)
  endif ()
  if (OpenMP_Fortran_FOUND)
    list(APPEND EXTERNAL_LIBS OpenMP::OpenMP_Fortran)
  endif ()
endif ()

if (Fortran_PP_FLAGS)
  message(STATUS "Specific Fortran preprocessor flags: ${Fortran_PP_FLAGS}")
else ()
  include(CheckFortranCompilerFlag)
  set(FORTRAN_PREPROCESSOR_OPTION_LISTS -Cpp;-fpp;-cpp)
  foreach (opt IN LISTS FORTRAN_PREPROCESSOR_OPTION_LISTS)
    check_fortran_compiler_flag(${opt} FORTRAN_${opt}_OPTIONS)
    if (FORTRAN_${opt}_OPTIONS)
      set(Fortran_PP_FLAGS ${opt})
      break()
    endif ()
  endforeach ()
  if (NOT DEFINED Fortran_PP_FLAGS)
    message(FATAL_ERROR "SALMON requires fortran preprocessing options (ex. -cpp/-fpp)")
  endif ()
endif ()

if (USE_MPI)
  check_mpi_compiler(${CMAKE_Fortran_COMPILER} IS_MPI_COMPILER)
  if (${IS_MPI_COMPILER})
    set(MPI_Fortran_COMPILER ${CMAKE_Fortran_COMPILER})
  endif ()

  check_mpi_compiler(${CMAKE_C_COMPILER} IS_MPI_COMPILER)
  if (${IS_MPI_COMPILER})
    set(MPI_C_COMPILER ${CMAKE_C_COMPILER})
  endif ()

  find_package(MPI REQUIRED)

  if (NOT DEFINED MPI_Fortran_FOUND)
    message(FATAL_ERROR "MPI Fortran compilers not found.")
  endif()

  if (NOT DEFINED MPI_C_FOUND)
    message(FATAL_ERROR "MPI C compilers not found.")
  endif()

  if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin")
    include_directories(${MPI_C_INCLUDE_DIRS} ${MPI_Fortran_INCLUDE_DIRS})
    set(CMAKE_EXE_LINKER_FLAGS "${MPI_C_LINK_FLAGS} ${MPI_Fortran_LINK_FLAGS} ${CMAKE_EXE_LINKER_FLAGS}")
    list(APPEND EXTERNAL_LIBS ${MPI_Fortran_LIBRARIES} ${MPI_C_LIBRARIES})
  else ()
    set(CMAKE_Fortran_COMPILER ${MPI_Fortran_COMPILER})
    set(CMAKE_C_COMPILER       ${MPI_C_COMPILER})
  endif ()
endif ()


if (CMAKE_Fortran_FLAGS_DEBUG)
else()
  set(CMAKE_Fortran_FLAGS_DEBUG "-O2 -g")
endif ()

if (CMAKE_Fortran_FLAGS_RELEASE)
else ()
  set(CMAKE_Fortran_FLAGS_RELEASE "-O3")
endif ()

if (CMAKE_C_FLAGS_DEBUG)
else ()
  set(CMAKE_C_FLAGS_DEBUG "-O2 -g")
endif ()

if (CMAKE_C_FLAGS_RELEASE)
else()
  set(CMAKE_C_FLAGS_RELEASE "-O3")
endif ()

set(C_OPENMP_FLAGS ${OPENMP_FLAGS})
if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_C_FLAGS MATCHES "(^| )-fopenmp( |$)")
  set(C_OPENMP_FLAGS "")
endif ()
set(FORTRAN_MPI_COMPAT_FLAGS "")
if (USE_MPI AND CMAKE_Fortran_COMPILER_ID STREQUAL "GNU" AND
    NOT CMAKE_Fortran_FLAGS MATCHES "(^| )-fallow-argument-mismatch( |$)")
  set(FORTRAN_MPI_COMPAT_FLAGS "-fallow-argument-mismatch")
endif ()

set(CMAKE_Fortran_FLAGS "${ARCH_FLAGS} ${OPENMP_FLAGS} ${MPI_Fortran_COMPILE_FLAGS} ${FORTRAN_MPI_COMPAT_FLAGS} ${Fortran_PP_FLAGS} ${ADDITIONAL_OPTIMIZE_FLAGS} ${CMAKE_Fortran_FLAGS}")
set(CMAKE_C_FLAGS       "${ARCH_FLAGS} ${C_OPENMP_FLAGS} ${MPI_C_COMPILE_FLAGS} ${ADDITIONAL_OPTIMIZE_FLAGS} ${CMAKE_C_FLAGS}")
