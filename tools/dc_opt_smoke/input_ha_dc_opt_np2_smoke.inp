&calculation
  theory = 'dft'
  yn_dc = 'y'
/

&control
  sysname = 'ha_dcopt_np2_smoke'
/

&units
  unit_system = 'a.u.'
/

&dc
  num_fragment(1:3) = 1,1,1
  nproc_rgrid_tot = 2,1,1
  yn_dc_lcfo = 'y'
  yn_dc_lcfo_diag = 'y'
  yn_dc_fragment_optimization = 'y'
  nstate_frag = 2
  num_rgrid_buffer = 2,0,0
/

&parallel
  nproc_k = 1
  nproc_ob = 1
  nproc_rgrid(1:3) = 2,1,1
/

&system
  yn_periodic = 'y'
  al = 20d0, 20d0, 20d0
  nstate = 4
  nelec = 2
  nelem = 1
  natom = 2
/

&pseudo
  file_pseudo(1) = './H_rps.dat'
  izatom(1) = 1
  lloc_ps(1) = 0
/

&functional
  xc = 'PZ'
/

&rgrid
  num_rgrid = 41, 40, 40
/

&scf
  nscf = 1
  threshold = 1.0d-6
/

&atomic_coor
  'H'  3.0d0   0.0d0   0.0d0  1
  'H' 13.0d0   0.0d0   0.0d0  1
/
